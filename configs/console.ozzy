// An Ozzy for a text console, as ozzyterm runs it: a screen of 80 by 24
// characters, which fits a standard console window, a keyboard, and a timer.
// This is the default Ozzy, written out to start from.

clock_hz: 1000000  // 1 Hz to 100 MHz
cores: 1           // 1 to 8
ports: 48          // 32 to 256
banks: [
  { ram: 0x7FFE }  // Pages 1 to 14: page 0 is the boot ROM, and 15 the screen
]
devices: [
  { type: "screen", columns: 80, rows: 24 }
  { type: "keyboard" }
  { type: "timer", tick_hz: 60 }  // Ticks a second
]

// Drives A: to D:, in order, each with its timing preset and the disk image in
// it at power on (relative to this file's folder), or none for an empty drive.
// Make one with oz3dsk, in this file's folder:
//   oz3dsk disks/system.ozd new 720K, then format
// drives: [
//   { preset: "floppy-1440k", image: "disks/system.ozd" }  // A:
// ]
