{
  "name": "OZ-3",

  // Ubuntu 24.04, as CI pins: its clang is 18. Newer clang (21) has warnings
  // that fail Game Bits' build.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  // Plain `cmake` calls pick clang without needing -DCMAKE_*_COMPILER.
  // -fstandalone-debug lets gdb and lldb show std::string, which clang
  // otherwise leaves to libstdc++'s debug symbols, not installed here. CMake
  // reads CXXFLAGS only when it configures a new build tree.
  "containerEnv": {
    "CC": "clang",
    "CXX": "clang++",
    "CXXFLAGS": "-fstandalone-debug"
  },

  // The reference clang-format (19.1.5, from PyPI) goes on PATH, after the
  // system tools so its venv's python doesn't shadow the system one.
  "remoteEnv": { "PATH": "${containerEnv:PATH}:/home/vscode/.venvs/clang-format/bin" },

  // Runs once when the codespace is created (and again on a rebuild).
  // Game Bits goes beside this repo as ../game-bits, where CMakeLists.txt finds
  // it without GB_DIR.
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y clang cmake ninja-build gdb python3-venv && if [ ! -d ../game-bits/.git ]; then sudo mkdir -p ../game-bits && sudo chown $(id -u):$(id -g) ../game-bits && git clone https://github.com/jpursey/game-bits ../game-bits; fi && git -C ../game-bits submodule update --init --recursive --depth 1 && python3 -m venv ~/.venvs/clang-format && ~/.venvs/clang-format/bin/pip install clang-format==19.1.5",

  "customizations": {
    "vscode": {
      // C++ TestMate lists each GoogleTest case in the Testing view, to run or
      // debug on its own. CMake Tools only knows each test binary as a whole.
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "matepek.vscode-catch2-test-adapter"
      ],
      "settings": {
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/out/build/linux-clang-${buildType}",
        "cmake.configureSettings": {
          "CMAKE_C_COMPILER": "clang",
          "CMAKE_CXX_COMPILER": "clang++"
        },
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "C_Cpp.clang_format_path": "/home/vscode/.venvs/clang-format/bin/clang-format"
      }
    }
  }
}
