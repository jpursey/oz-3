################################################################################
## Shared macros to fetch word and dword values
################################################################################

# Returns a word value as a register.
#
# Ends fetch phase.
# Modifies register "C2" and returns result in register "r".
macro(bits:5) GetWord:r {
  code:m "$r" {
    UL;
  }
  code:C2 "($r)" {
    UL; LKR(m); ADR(m); LD(C2); UL;
  }
  code:C2 "($r + $v)" {
    LD(C2); UL; ADD(C2,m); LKR(m); ADR(C2); LD(C2); UL;
  }
  code:C2 "(SP)" {
    UL; LK(STACK); ADR(SP); LD(C2); UL;
  }
  code:C2 "(SP + $v)" {
    LD(C2); UL; ADD(C2,SP); LK(STACK); ADR(C2); LD(C2); UL;
  }
  code:C2 "(FP)" {
    UL; LK(STACK); ADR(FP); LD(C2); UL;
  }
  code:C2 "(FP + $v)" {
    LD(C2); UL; ADD(C2,FP); LK(STACK); ADR(C2); LD(C2); UL;
  }
  code:C2 "$v" {
    LD(C2); UL;
  }
  code:C2 "S($v)" {
    LD(C2); UL; LK(STACK); ADR(C2); LD(C2); UL;
  }
  code:C2 "D($v)" {
    LD(C2); UL; LK(DATA); ADR(C2); LD(C2); UL;
  }
  code:C2 "E($v)" {
    LD(C2); UL; LK(EXTRA); ADR(C2); LD(C2); UL;
  }
}

# Returns a dword value as a register.
#
# Ends fetch phase.
# Modifies register "C0" and "C1" and returns result in register "R".
macro(bits:5) GetDword:R {
  code:M "$R" {
    UL;
  }
  code:CD "[$r]" {
    UL; LKR(m); ADR(m); LD(C0); LD(C1); UL;
  }
  code:CD "[$r + $v]" {
    LD(C0); UL; ADD(C0,m); LKR(m); ADR(C0); LD(C0); LD(C1); UL;
  }
  code:CD "[SP]" {
    UL; LK(STACK); ADR(SP); LD(C0); LD(C1); UL;
  }
  code:CD "[SP + $v]" {
    LD(C0); UL; ADD(C0,SP); LK(STACK); ADR(C0); LD(C0); LD(C1); UL;
  }
  code:CD "[FP]" {
    UL; LK(STACK); ADR(FP); LD(C0); LD(C1); UL;
  }
  code:CD "[FP + $v]" {
    LD(C0); UL; ADD(C0,FP); LK(STACK); ADR(C0); LD(C0); LD(C1); UL;
  }
  code:CD "$V" {
    LD(C0); LD(C1); UL;
  }
  code:CD "S[$v]" {
    LD(C0); UL; LK(STACK); ADR(C0); LD(C0); LD(C1); UL;
  }
  code:CD "D[$v]" {
    LD(C0); UL; LK(DATA); ADR(C0); LD(C0); LD(C1); UL;
  }
  code:CD "E[$v]" {
    LD(C0); UL; LK(EXTRA); ADR(C0); LD(C0); LD(C1); UL;
  }
}

# Returns a 16-bit mask for a specified bit position (0-15) otherwise
# returns zero
#
# Ends fetch phase.
# Requires C0 and C2 are zero.
# Modifies C0, C2.
macro(bits:5) Get16BitMask:r {
  code:C0 "$r" {
    UL;
    CMPI(m,16);
    JC(NC,@done);  # The mask is zero, as C0 already is
    MOVI(C0,1);
    OR(C2,m);  # Copies and tests the position, as C2 is zero
    JC(Z,@done);
  @shift:
    SL(C0);
    JD(C2,@shift);
  @done:
    MSS(_);
  }

  code:C0 "0"  { UL; MVBI(C0:L,0x01); }
  code:C0 "1"  { UL; MVBI(C0:L,0x02); }
  code:C0 "2"  { UL; MVBI(C0:L,0x04); }
  code:C0 "3"  { UL; MVBI(C0:L,0x08); }
  code:C0 "4"  { UL; MVBI(C0:L,0x10); }
  code:C0 "5"  { UL; MVBI(C0:L,0x20); }
  code:C0 "6"  { UL; MVBI(C0:L,0x40); }
  code:C0 "7"  { UL; MVBI(C0:L,0x80); }
  code:C0 "8"  { UL; MVBI(C0:H,0x01); }
  code:C0 "9"  { UL; MVBI(C0:H,0x02); }
  code:C0 "10"  { UL; MVBI(C0:H,0x04); }
  code:C0 "11"  { UL; MVBI(C0:H,0x08); }
  code:C0 "12"  { UL; MVBI(C0:H,0x10); }
  code:C0 "13"  { UL; MVBI(C0:H,0x20); }
  code:C0 "14"  { UL; MVBI(C0:H,0x40); }
  code:C0 "15"  { UL; MVBI(C0:H,0x80); }
}

# Returns a 32-bit mask for a specified bit position (0-31) otherwise
# returns zero
#
# Ends fetch phase.
# Requires: C0, C1, and C2 are zero
# Modifies: C0, C1, C2
macro(bits:6) Get32BitMask:R {
  code:CD "$r" {
    UL;
    CMPI(m,16);
    JC(Z,@sixteen);
    JC(NC,@upper);
    MOVI(C0,1);
    OR(C2,m);  # Copies and tests the position, as C2 is zero
    JC(Z,@done);
  @shift_lower:
    SL(C0);
    JD(C2,@shift_lower);
    JP(@done);
  @sixteen:
    MOVI(C1,1);
    JP(@done);
  @upper:
    CMPI(m,32);
    JC(NC,@done);  # The mask is zero, as C0 and C1 already are
    MVN(C2:0,m:0);  # The position is 17-31, so this is 1-15 more than 16
    MOVI(C1,1);
  @shift_upper:
    SL(C1);
    JD(C2,@shift_upper);
  @done:
    MSS(_);
  }

  code:CD "0"  { UL; MVBI(C0:L,0x01); }
  code:CD "1"  { UL; MVBI(C0:L,0x02); }
  code:CD "2"  { UL; MVBI(C0:L,0x04); }
  code:CD "3"  { UL; MVBI(C0:L,0x08); }
  code:CD "4"  { UL; MVBI(C0:L,0x10); }
  code:CD "5"  { UL; MVBI(C0:L,0x20); }
  code:CD "6"  { UL; MVBI(C0:L,0x40); }
  code:CD "7"  { UL; MVBI(C0:L,0x80); }
  code:CD "8"  { UL; MVBI(C0:H,0x01); }
  code:CD "9"  { UL; MVBI(C0:H,0x02); }
  code:CD "10"  { UL; MVBI(C0:H,0x04); }
  code:CD "11"  { UL; MVBI(C0:H,0x08); }
  code:CD "12"  { UL; MVBI(C0:H,0x10); }
  code:CD "13"  { UL; MVBI(C0:H,0x20); }
  code:CD "14"  { UL; MVBI(C0:H,0x40); }
  code:CD "15"  { UL; MVBI(C0:H,0x80); }
  code:CD "16"  { UL; MVBI(C1:L,0x01); }
  code:CD "17"  { UL; MVBI(C1:L,0x02); }
  code:CD "18"  { UL; MVBI(C1:L,0x04); }
  code:CD "19"  { UL; MVBI(C1:L,0x08); }
  code:CD "20"  { UL; MVBI(C1:L,0x10); }
  code:CD "21"  { UL; MVBI(C1:L,0x20); }
  code:CD "22"  { UL; MVBI(C1:L,0x40); }
  code:CD "23"  { UL; MVBI(C1:L,0x80); }
  code:CD "24"  { UL; MVBI(C1:H,0x01); }
  code:CD "25"  { UL; MVBI(C1:H,0x02); }
  code:CD "26"  { UL; MVBI(C1:H,0x04); }
  code:CD "27"  { UL; MVBI(C1:H,0x08); }
  code:CD "28"  { UL; MVBI(C1:H,0x10); }
  code:CD "29"  { UL; MVBI(C1:H,0x20); }
  code:CD "30"  { UL; MVBI(C1:H,0x40); }
  code:CD "31"  { UL; MVBI(C1:H,0x80); }
}

################################################################################
## NOP
##
## Cycles: 3
## ZSCO: ----
##
## Minimal instruction that does nothing.
################################################################################

instruction(opcode:0) NOP {
  UL;
}

################################################################################
## HALT
##
## Cycles: 4
## ZSCO: ----
##
## Puts the core into the IDLE state. Interrupts will still be triggered and
## executed, but the core will stay idle until it is reset to a new code
## location.
################################################################################

instruction HALT {
  UL;
  ADDI(IP,-1);  # Reset IP so core stays halted after interrupt
  HALT;         # Put the core into idle state.
}

################################################################################
## WAIT <reg>
##
## Cycles: 3-65535
## ZSCO: ---X
##
## Puts the core into the WAIT state for at least the number of cycles
## specified, counting from the start of the WAIT instruction. A WAIT takes at
## least 3 cycles, so 0 to 3 all take 3. Interrupts may still be executed
## during the WAIT state, but cannot recursively call WAIT themselves.
##
## After a successful WAIT execution (it was not called recursively from within
## an interrupt), the provided register will be update with the number of
## additional cycles taken. This may be longer than the requested time due to
## an interrupt occurring or the core getting locked.
##
## On failure, the O flag is set. Otherwise it is cleared.
################################################################################

instruction WAIT "$r" {
  UL;
  WAIT(a);
}

################################################################################
## MOV <dst> <src>
##
## Cycles: 4-10
## ZSCO: ----
##
## Variants:
##    MOV.LW  <reg>, <reg>                  (4 cycles)
##    MOV.LW  <reg>, <integer>              (4 cycles)
##    MOV.LW  <reg>, <word-address>         (5-7 cycles)
##    MOV.LD  <dreg>, <dreg>                (5 cycles)
##    MOV.LD  <dreg>, <integer>             (5 cycles)
##    MOV.LD  <dreg>, <dword-address>       (6-8 cycles)
##    MOV.SWR <word-address>, <reg>         (5-7 cycles)
##    MOV.SDR <dword-address>, <dreg>       (6-8 cycles)
##    MOV.SWV <word-address>, <integer>     (6-8 cycles)
##    MOV.SDV <dword-address>, <integer>    (8-10 cycles)
##    MOV.S   <reg>, <sreg>                 (4 cycles)
##    MOV.S   <sreg>, <reg>                 (4 cycles)
##    MOV.S   <sreg>, <integer>             (4 cycles)
##
## Moves (copies) the value from from <src> into <dst>.
################################################################################

macro(bits:5) LoadWord(p) {
  code "$r"         { UL; MOV(p,m); }
  code "($r)"       { UL; LKR(m); ADR(m); LD(p); UL; }
  code "($r + $v)"  { LD(C2); UL; ADD(C2,m); LKR(m); ADR(C2); LD(p); UL; }
  code "(SP)"       { UL; LK(STACK); ADR(SP); LD(p); UL; }
  code "(SP + $v)"  { LD(C2); UL; ADD(C2,SP); LK(STACK); ADR(C2); LD(p); UL; }
  code "(FP)"       { UL; LK(STACK); ADR(FP); LD(p); UL; }
  code "(FP + $v)"  { LD(C2); UL; ADD(C2,FP); LK(STACK); ADR(C2); LD(p); UL; }
  code "$v"         { LD(p); UL; }
  code "S($v)"      { LD(C2); UL; LK(STACK); ADR(C2); LD(p); UL; }
  code "D($v)"      { LD(C2); UL; LK(DATA); ADR(C2); LD(p); UL; }
  code "E($v)"      { LD(C2); UL; LK(EXTRA); ADR(C2); LD(p); UL; }
}

instruction MOV.LW "$r, $m" {
  $LoadWord(a);
}

macro(bits:5) LoadDword(P) {
  code "$R" {
    UL; MOV(p0,m0); MOV(p1,m1);
  }
  code "[$r]" {
    UL; LKR(m); ADR(m); LD(p0); LD(p1); UL;
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m); LKR(m); ADR(C2); LD(p0); LD(p1); UL;
  }
  code "[SP]" {
    UL; LK(STACK); ADR(SP); LD(p0); LD(p1); UL;
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP); LK(STACK); ADR(C2); LD(p0); LD(p1); UL;
  }
  code "[FP]" {
    UL; LK(STACK); ADR(FP); LD(p0); LD(p1); UL;
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP); LK(STACK); ADR(C2); LD(p0); LD(p1); UL;
  }
  code "$V" {
    LD(p0); LD(p1); UL;
  }
  code "S[$v]" {
    LD(C2); UL; LK(STACK); ADR(C2); LD(p0); LD(p1); UL;
  }
  code "D[$v]" {
    LD(C2); UL; LK(DATA); ADR(C2); LD(p0); LD(p1); UL;
  }
  code "E[$v]" {
    LD(C2); UL; LK(EXTRA); ADR(C2); LD(p0); LD(p1); UL;
  }
}

instruction MOV.LD "$R, $m" {
  $LoadDword(A);
}

macro(bits:5) StoreWordRegister(p) {
  code "($r)"       { UL; LKR(m); ADR(m); ST(p); UL; }
  code "($r + $v)"  { LD(C2); UL; ADD(C2,m); LKR(m); ADR(C2); ST(p); UL; }
  code "(SP)"       { UL; LK(STACK); ADR(SP); ST(p); UL; }
  code "(SP + $v)"  { LD(C2); UL; ADD(C2,SP); LK(STACK); ADR(C2); ST(p); UL; }
  code "(FP)"       { UL; LK(STACK); ADR(FP); ST(p); UL; }
  code "(FP + $v)"  { LD(C2); UL; ADD(C2,FP); LK(STACK); ADR(C2); ST(p); UL; }
  code "S($v)"      { LD(C2); UL; LK(STACK); ADR(C2); ST(p); UL; }
  code "D($v)"      { LD(C2); UL; LK(DATA); ADR(C2); ST(p); UL; }
  code "E($v)"      { LD(C2); UL; LK(EXTRA); ADR(C2); ST(p); UL; }
}

instruction MOV.SWR "$m, $r" {
  $StoreWordRegister(b);
}

macro(bits:5) StoreWordValue {
  code "($r), $v" {
    LD(C1); UL; LKR(m); ADR(m); ST(C1); UL;
  }
  code "($r + $v), $v" {
    LD(C2); LD(C1); UL; ADD(C2,m); LKR(m); ADR(C2); ST(C1); UL;
  }
  code "(SP), $v" {
    LD(C1); UL; LK(STACK); ADR(SP); ST(C1); UL;
  }
  code "(SP + $v), $v" {
    LD(C2); LD(C1); UL; ADD(C2,SP); LK(STACK); ADR(C2); ST(C1); UL;
  }
  code "(FP), $v" {
    LD(C1); UL; LK(STACK); ADR(FP); ST(C1); UL;
  }
  code "(FP + $v), $v" {
    LD(C2); LD(C1); UL; ADD(C2,FP); LK(STACK); ADR(C2); ST(C1); UL;
  }
  code "S($v), $v" {
    LD(C2); LD(C1); UL; LK(STACK); ADR(C2); ST(C1); UL;
  }
  code "D($v), $v" {
    LD(C2); LD(C1); UL; LK(DATA); ADR(C2); ST(C1); UL;
  }
  code "E($v), $v" {
    LD(C2); LD(C1); UL; LK(EXTRA); ADR(C2); ST(C1); UL;
  }
}

instruction MOV.SWV "$m" {
  $StoreWordValue;
}

macro(bits:5) StoreDwordRegister(P) {
  code "[$r]" {
    UL; LKR(m); ADR(m); ST(p0); ST(p1); UL;
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m); LKR(m); ADR(C2); ST(p0); ST(p1); UL;
  }
  code "[SP]" {
    UL; LK(STACK); ADR(SP); ST(p0); ST(p1); UL;
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP); LK(STACK); ADR(C2); ST(p0); ST(p1); UL;
  }
  code "[FP]" {
    UL; LK(STACK); ADR(FP); ST(p0); ST(p1); UL;
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP); LK(STACK); ADR(C2); ST(p0); ST(p1); UL;
  }
  code "S[$v]" {
    LD(C2); UL; LK(STACK); ADR(C2); ST(p0); ST(p1); UL;
  }
  code "D[$v]" {
    LD(C2); UL; LK(DATA); ADR(C2); ST(p0); ST(p1); UL;
  }
  code "E[$v]" {
    LD(C2); UL; LK(EXTRA); ADR(C2); ST(p0); ST(p1); UL;
  }
}

instruction MOV.SDR "$m, $R" {
  $StoreDwordRegister(B);
}

macro(bits:5) StoreDwordValue {
  code "[$r], $v" {
    LD(C0); LD(C1); UL;
    LKR(m); ADR(m); ST(C0); ST(C1); UL;
  }
  code "[$r + $v], $v" {
    LD(C2); LD(C0); LD(C1); UL; ADD(C2,m);
    LKR(m); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "[SP], $v" {
    LD(C0); LD(C1); UL;
    LK(STACK); ADR(SP); ST(C0); ST(C1); UL;
  }
  code "[SP + $v], $v" {
    LD(C2); LD(C0); LD(C1); UL; ADD(C2,SP);
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "[FP], $v" {
    LD(C0); LD(C1); UL;
    LK(STACK); ADR(FP); ST(C0); ST(C1); UL;
  }
  code "[FP + $v], $v" {
    LD(C2); LD(C0); LD(C1); UL; ADD(C2,FP);
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "S[$v], $v" {
    LD(C2); LD(C0); LD(C1); UL;
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "D[$v], $v" {
    LD(C2); LD(C0); LD(C1); UL;
    LK(DATA); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "E[$v], $v" {
    LD(C2); LD(C0); LD(C1); UL;
    LK(EXTRA); ADR(C2); ST(C0); ST(C1); UL;
  }
}

instruction MOV.SDV "$m" {
  $StoreDwordValue;
}

macro MoveSReg {
  code "$r, BC" { UL; MOV(m,BC); }
  code "$r, BS" { UL; MOV(m,BS); }
  code "$r, BD" { UL; MOV(m,BD); }
  code "$r, BE" { UL; MOV(m,BE); }
  code "$r, FP" { UL; MOV(m,FP); }
  code "$r, SP" { UL; MOV(m,SP); }
  code "BC, $r" { UL; MOV(BC,m); }
  code "BS, $r" { UL; MOV(BS,m); }
  code "BD, $r" { UL; MOV(BD,m); }
  code "BE, $r" { UL; MOV(BE,m); }
  code "FP, $r" { UL; MOV(FP,m); }
  code "SP, $r" { UL; MOV(SP,m); }

  # The fetch phase may load straight into any register (see the microcode
  # reference), so the value goes straight into the register.
  code "BC, $v" { LD(BC); UL; }
  code "BS, $v" { LD(BS); UL; }
  code "BD, $v" { LD(BD); UL; }
  code "BE, $v" { LD(BE); UL; }
  code "FP, $v" { LD(FP); UL; }
  code "SP, $v" { LD(SP); UL; }
}

instruction MOV.S "$m" {
  $MoveSReg;
}

################################################################################
## MVQ <dst> <value>
##
## Cycles: 4-5
## ZSCO: ----
##
## Variants:
##    MVQ.LW <reg>, <0..31>     (4 cycles)
##    MVQ.LD <dreg>, <0..31>    (5 cycles)
##
## Moves the immediate value in the range [0,31] to the specified register.
################################################################################

instruction MVQ.LW "$r, $#5" {
  UL; MOV(a,C1);
}

instruction MVQ.LD "$R, $#5" {
  UL; MOV(a0,C1); MOVI(a1,0);
}

################################################################################
## PUSH <src>
##
## Cycles: 5-11
## ZSCO: ----
##
## Variants:
##    PUSH.W <reg>              (5 cycles)
##    PUSH.W <integer>          (6 cycles)
##    PUSH.W <word-address>     (7-9 cycles)
##    PUSH.D <dreg>             (6 cycles)
##    PUSH.D <integer>          (8 cycles)
##    PUSH.D <dword-address>    (9-11 cycles)
##
## Pushes the value onto the stack, updating SP.
################################################################################

instruction PUSH.W "$m" {
  $GetWord;
  LK(STACK); ADR(SP); STP(r); LAD(SP); UL;
}

instruction PUSH.D "$m" {
  $GetDword;
  LK(STACK); ADR(SP); STP(r1); STP(r0); LAD(SP); UL;
}

################################################################################
## POP <dst>
##
## Cycles: 5-11
## ZSCO: ----
##
## Variants:
##    POP.W <reg>              (5 cycles)
##    POP.W <word-address>     (6-9 cycles)
##    POP.D <dreg>             (6 cycles)
##    POP.D <dword-address>    (8-11 cycles)
##
## Pops the value from the stack, updating SP. The destination address is
## determined *after* the the value is popped, which affects addresses using an
## offset from SP.
################################################################################

macro PopWord {
  code "$r" {
    UL;
    LK(STACK); ADR(SP); LD(m); LAD(SP); UL;
  }
  code "($r)" {
    UL;
    LK(STACK); ADR(SP); LD(C2); LAD(SP); UL;
    LKR(m); ADR(m); ST(C2); UL;
  }
  code "($r + $v)" {
    LD(C0); UL;
    LK(STACK); ADR(SP); LD(C2); LAD(SP); UL;
    ADD(C0,m); LKR(m); ADR(C0); ST(C2); UL;
  }
  code "(SP)" {
    UL;
    LK(STACK);
      ADR(SP); LD(C2); LAD(SP);
      ST(C2);
    UL;
  }
  code "(SP + $v)" {
    LD(C0); UL;
    LK(STACK);
      ADR(SP); LD(C2); LAD(SP);
      ADD(C0,SP); ADR(C0); ST(C2);
    UL;
  }
  code "(FP)" {
    UL;
    LK(STACK);
      ADR(SP); LD(C2); LAD(SP);
      ADR(FP); ST(C2);
    UL;
  }
  code "(FP + $v)" {
    LD(C0); UL;
    LK(STACK);
      ADR(SP); LD(C2); LAD(SP);
      ADD(C0,FP); ADR(C0); ST(C2);
    UL;
  }
  code "S($v)" {
    LD(C0); UL;
    LK(STACK);
      ADR(SP); LD(C2); LAD(SP);
      ADR(C0); ST(C2);
    UL;
  }
  code "D($v)" {
    LD(C0); UL;
    LK(STACK); ADR(SP); LD(C2); LAD(SP); UL;
    LK(DATA); ADR(C0); ST(C2); UL;
  }
  code "E($v)" {
    LD(C0); UL;
    LK(STACK); ADR(SP); LD(C2); LAD(SP); UL;
    LK(EXTRA); ADR(C0); ST(C2); UL;
  }
}

instruction POP.W "$m" {
  $PopWord;
}

macro PopDword {
  code "$R" {
    UL;
    LK(STACK); ADR(SP); LD(m0); LD(m1); LAD(SP); UL;
  }
  code "[$r]" {
    UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); LAD(SP); UL;
    LKR(m); ADR(m); ST(C0); ST(C1); UL;
  }
  code "[$r + $v]" {
    LD(C2); UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); LAD(SP); UL;
    ADD(C2,m); LKR(m); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "[SP]" {
    UL;
    LK(STACK);
      ADR(SP); LD(C0); LD(C1); LAD(SP);
      ST(C0); ST(C1);
    UL;
  }
  code "[SP + $v]" {
    LD(C2); UL;
    LK(STACK);
      ADR(SP); LD(C0); LD(C1); LAD(SP);
      ADD(C2,SP); ADR(C2); ST(C0); ST(C1);
    UL;
  }
  code "[FP]" {
    UL;
    LK(STACK);
      ADR(SP); LD(C0); LD(C1); LAD(SP);
      ADR(FP); ST(C0); ST(C1);
    UL;
  }
  code "[FP + $v]" {
    LD(C2); UL;
    LK(STACK);
      ADR(SP); LD(C0); LD(C1); LAD(SP);
      ADD(C2,FP); ADR(C2); ST(C0); ST(C1);
    UL;
  }
  code "S[$v]" {
    LD(C2); UL;
    LK(STACK);
      ADR(SP); LD(C0); LD(C1); LAD(SP);
      ADR(C2); ST(C0); ST(C1);
    UL;
  }
  code "D[$v]" {
    LD(C2); UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); LAD(SP); UL;
    LK(DATA); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "E[$v]" {
    LD(C2); UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); LAD(SP); UL;
    LK(EXTRA); ADR(C2); ST(C0); ST(C1); UL;
  }
}

instruction POP.D "$m" {
  $PopDword;
}

################################################################################
## SWP <a> <b>
##
## Cycles: 6-12
## ZSCO: ----
##
## Variants:
##    SWP.W <reg>, <reg>               (6 cycles)
##    SWP.W <reg>, <word-address>      (7-9 cycles)
##    SWP.D <dreg>, <dreg>             (9 cycles)
##    SWP.D <dreg>, <dword-address>    (10-12 cycles)
##
## Swaps the contents of the specified register <a> with a register or memory
## address value <b>
################################################################################

macro SwapWord(p) {
  code "$r" {
    UL;
    MOV(C0,p); MOV(p,m); MOV(m,C0);
  }
  code "($r)" {
    UL;
    MOV(C0,p); LKR(m); ADR(m); LD(p); STP(C0); UL;
  }
  code "($r + $v)" {
    LD(C2); UL; ADD(C2,m);
    MOV(C0,p); LKR(m); ADR(C2); LD(p); STP(C0); UL;
  }
  code "(SP)" {
    UL;
    MOV(C0,p); LK(STACK); ADR(SP); LD(p); STP(C0); UL;
  }
  code "(SP + $v)" {
    LD(C2); UL; ADD(C2,SP);
    MOV(C0,p); LK(STACK); ADR(C2); LD(p); STP(C0); UL;
  }
  code "(FP)" {
    UL;
    MOV(C0,p); LK(STACK); ADR(FP); LD(p); STP(C0); UL;
  }
  code "(FP + $v)" {
    LD(C2); UL; ADD(C2,FP);
    MOV(C0,p); LK(STACK); ADR(C2); LD(p); STP(C0); UL;
  }
  code "S($v)" {
    LD(C2); UL;
    MOV(C0,p); LK(STACK); ADR(C2); LD(p); STP(C0); UL;
  }
  code "D($v)" {
    LD(C2); UL;
    MOV(C0,p); LK(DATA); ADR(C2); LD(p); STP(C0); UL;
  }
  code "E($v)" {
    LD(C2); UL;
    MOV(C0,p); LK(EXTRA); ADR(C2); LD(p); STP(C0); UL;
  }
}

instruction SWP.W "$r, $m" {
  $SwapWord(a);
}

macro SwapDword(P) {
  code "$R" {
    UL;
    MOV(C0,p0); MOV(p0,m0); MOV(m0,C0);
    MOV(C1,p1); MOV(p1,m1); MOV(m1,C1);
  }
  code "[$r]" {
    UL;
    MOV(C0,p0); MOV(C1,p1);
    LKR(m); ADR(m); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m);
    MOV(C0,p0); MOV(C1,p1);
    LKR(m); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "[SP]" {
    UL;
    MOV(C0,p0); MOV(C1,p1);
    LK(STACK); ADR(SP); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP);
    MOV(C0,p0); MOV(C1,p1);
    LK(STACK); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "[FP]" {
    UL;
    MOV(C0,p0); MOV(C1,p1);
    LK(STACK); ADR(FP); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP);
    MOV(C0,p0); MOV(C1,p1);
    LK(STACK); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "S[$v]" {
    LD(C2); UL;
    MOV(C0,p0); MOV(C1,p1);
    LK(STACK); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "D[$v]" {
    LD(C2); UL;
    MOV(C0,p0); MOV(C1,p1);
    LK(DATA); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
  code "E[$v]" {
    LD(C2); UL;
    MOV(C0,p0); MOV(C1,p1);
    LK(EXTRA); ADR(C2); LD(p0); LD(p1); STP(C1); STP(C0); UL;
  }
}

instruction SWP.D "$R, $m" {
  $SwapDword(A);
}

################################################################################
## MVI (<address-register>), (<address-register>)
##
## Cycles: 7
## ZSCO: ----
##
## Copies the word at the address in the second register to the address in the
## first (each in the memory bank its register implies), then steps both
## address registers up by one.
##
## The second register is stepped before the first is used, so if they are the
## same register, the word is copied to the next address, and the register is
## stepped by two.
################################################################################

instruction MVI "($r), ($r)" {
  UL;
  LKR(b); ADR(b); LD(C0); LAD(b); UL;
  LKR(a); ADR(a); ST(C0); LAD(a); UL;
}

################################################################################
## MVD (<address-register>), (<address-register>)
##
## Cycles: 9
## ZSCO: ----
##
## Copies the word at the address in the second register to the address in the
## first (each in the memory bank its register implies), then steps both
## address registers down by one.
##
## The second register is stepped before the first is used, so if they are the
## same register, the word is copied to the next address down, and the
## register is stepped by two.
################################################################################

instruction MVD "($r), ($r)" {
  UL;
  LKR(b); ADR(b); LD(C0); UL;
  ADDI(b,-1);
  LKR(a); ADR(a); ST(C0); UL;
  ADDI(a,-1);
}

################################################################################
## MVIR (<address-register>), (<address-register>)
##
## Cycles: 6 or 9 per word
## ZSCO: ----
##
## MVI, decrementing the count in R7 for each word, repeated until R7 is 0.
## Each execution copies one word, and then executes the instruction again if
## it isn't done, so interrupts are handled between words. Each word takes 9
## cycles.
##
## If R7 is 0, nothing is copied, and it takes 6 cycles.
################################################################################

instruction MVIR "($r), ($r)" {
  UL;

  # R7 is decremented first, which clears C if it was 0, and sets Z if this is
  # the last word. Nothing after it changes Z or C, and R7 is restored if no
  # word is copied.
  ADDI(R7,-1);
  JC(NC,@restore);
  LKR(b); ADR(b); LD(C0); LAD(b); UL;  # As MVI
  LKR(a); ADR(a); ST(C0); LAD(a); UL;
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@restore:
  ADDI(R7,1);
}

################################################################################
## MVDR (<address-register>), (<address-register>)
##
## Cycles: 6 or 11 per word
## ZSCO: ----
##
## MVD, decrementing the count in R7 for each word, repeated until R7 is 0.
## Each execution copies one word, and then executes the instruction again if
## it isn't done, so interrupts are handled between words. Each word takes 11
## cycles.
##
## If R7 is 0, nothing is copied, and it takes 6 cycles.
################################################################################

instruction MVDR "($r), ($r)" {
  UL;
  ADDI(R7,-1);  # As MVIR
  JC(NC,@restore);

  # As MVD, stepping the addresses down with JD (which always lands on the next
  # microcode), as ADDI would change the flags.
  LKR(b); ADR(b); LD(C0); UL;
  JD(b,@source_stepped);
@source_stepped:
  LKR(a); ADR(a); ST(C0); UL;
  JD(a,@stepped);
@stepped:
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@restore:
  ADDI(R7,1);
}

################################################################################
## NEG <register>
##
## Cycles: 4-6
## ZSCO: XX0X
##
## Variants:
##    NEG.W <reg>     (4 cycles)
##    NEG.D <dreg>    (5-6 cycles)
##
## Negates the value in the specified register. NEG.D takes one more cycle when
## the low word is zero.
################################################################################

instruction NEG.W "$r" {
  UL;
  NEG(a,a); MSR(ZSCO,ZSCO);
}

instruction NEG.D "$R" {
  UL;

  # Negate the low word, which sets Z if it is zero (and so stays zero).
  NEG(a0,a0); MSR(Z,Z);

  # The high word is negated if the low word is zero, and otherwise it is
  # NOTed, as there is a borrow. Only NEG can overflow (0x80000000), and both
  # clear C. Z is cleared (but not set) based on the high word.
  JC(Z,@low_zero);
  NOT(a1,a1); MSR(ZSCO,_SCO);
  END;
@low_zero:
  NEG(a1,a1); MSR(ZSCO,_SCO);
}

################################################################################
## ADD <register>, <value>
##
## Cycles: 4+
## ZSCO: XXXX
##
## Variants:
##    ADD.W <reg>, <word-value>
##    ADD.D <dreg>, <dword-value>
##    ADD.S SP, <word-value>
##
## Adds a value to the specified register.
################################################################################

instruction ADD.W "$r, $m" {
  $GetWord;
  ADD(a,r);
  MSR(ZSCO,ZSCO);
}

instruction ADD.D "$R, $m" {
  $GetDword;
  ADD(a0,r0);
  MSR(Z,Z);
  ADC(a1,r1);
  MSR(ZSCO,_SCO);
}

instruction ADD.S "SP, $m" {
  $GetWord;
  ADD(SP,r);
  MSR(ZSCO,ZSCO);
}

################################################################################
## ADQ <register>, <value>
##
## Cycles: 4-5
## ZSCO: XXXX
##
## Variants:
##    ADQ.W <reg>, <0..31>
##    ADQ.D <dreg>, <0..31>
##    ADQ.S SP, <0..31>
##
## Adds an immediate value to the specified register.
################################################################################

instruction ADQ.W "$r, $#5" {
  UL;
  ADD(a,C1);
  MSR(ZSCO,ZSCO);
}

instruction ADQ.D "$R, $#5" {
  UL;
  ADD(a0,C1);
  MSR(Z,Z);
  ADC(a1,C2);
  MSR(ZSCO,_SCO);
}

instruction ADQ.S "SP, $#5" {
  UL;
  ADD(SP,C0);
  MSR(ZSCO,ZSCO);
}

################################################################################
## ADC <register>, <value>
##
## Cycles: 4+
## ZSCO: XXXX
##
## Variants:
##    ADC.W <reg>, <word-value>
##    ADC.D <dreg>, <dword-value>
##
## Adds a value to the specified register.
################################################################################

instruction ADC.W "$r, $m" {
  $GetWord;
  ADC(a,r);
  MSR(ZSCO,ZSCO);
}

instruction ADC.D "$R, $m" {
  $GetDword;
  ADC(a0,r0);
  MSR(Z,Z);
  ADC(a1,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## SUB <register>, <value>
##
## Cycles: 4+
## ZSCO: XXXX
##
## Variants:
##    SUB.W <reg>, <word-value>
##    SUB.D <dreg>, <dword-value>
##    SUB.S SP, <word-value>
##
## Subtracts a value to the specified register.
################################################################################

instruction SUB.W "$r, $m" {
  $GetWord;
  SUB(a,r);
  MSR(ZSCO,ZSCO);
}

instruction SUB.D "$R, $m" {
  $GetDword;
  SUB(a0,r0);
  MSR(Z,Z);
  SBC(a1,r1);
  MSR(ZSCO,_SCO);
}

instruction SUB.S "SP, $m" {
  $GetWord;
  SUB(SP,r);
  MSR(ZSCO,ZSCO);
}

################################################################################
## SBQ <register>, <value>
##
## Cycles: 4-5
## ZSCO: XXXX
##
## Variants:
##    SBQ.W <reg>, <0..31>
##    SBQ.D <dreg>, <0..31>
##    SBQ.S SP, <0..31>
##
## Subtracts an immediate value to the specified register.
################################################################################

instruction SBQ.W "$r, $#5" {
  UL;
  SUB(a,C1);
  MSR(ZSCO,ZSCO);
}

instruction SBQ.D "$R, $#5" {
  UL;
  SUB(a0,C1);
  MSR(Z,Z);
  SBC(a1,C2);
  MSR(ZSCO,_SCO);
}

instruction SBQ.S "SP, $#5" {
  UL;
  SUB(SP,C0);
  MSR(ZSCO,ZSCO);
}

################################################################################
## SBC <register>, <value>
##
## Cycles: 4+
## ZSCO: XXXX
##
## Variants:
##    SBC.W <reg>, <word-value>
##    SBC.D <dreg>, <dword-value>
##
## Adds a value to the specified register.
################################################################################

instruction SBC.W "$r, $m" {
  $GetWord;
  SBC(a,r);
  MSR(ZSCO,ZSCO);
}

instruction SBC.D "$R, $m" {
  $GetDword;
  SBC(a0,r0);
  MSR(Z,Z);
  SBC(a1,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## MUL <register>, <value>
##
## Cycles: 7-102
## ZSCO: XXXX
##
## Variants:
##    MUL.W  <reg>, <reg>              (7-68 cycles)
##    MUL.W  <reg>, <integer>          (7-68 cycles)
##    MUL.W  <reg>, <word-address>     (8-71 cycles)
##    MUL.DW <dreg>, <reg>             (8-99 cycles)
##    MUL.DW <dreg>, <integer>         (8-99 cycles)
##    MUL.DW <dreg>, <word-address>    (9-102 cycles)
##
## Unsigned multiply of the register by a word value. The register gets the low
## bits of the product. The "C" and "O" flags are both set if the product
## doesn't fit in the register, and both cleared otherwise.
##
## The cycles depend on the value. For a value of 1, MUL.W <reg>, <reg> takes 7
## cycles (and 8 for 0). Each bit above that up to the value's highest set bit
## adds 2 cycles (3 for MUL.DW), and so does each set bit other than the
## highest. It takes one more cycle if the product doesn't fit.
################################################################################

instruction MUL.W "$r, $m" {
  # For each bit set in the value (shifted out of C1), add the register into
  # the product in C0 (which starts as zero), shifting the register left each
  # bit, until no bits of the value are left. The last bit is always set, so
  # its add goes into the register, and needn't shift. The value is loaded
  # into C1 (copied, for a register), as it may be the register itself.
  $LoadWord(C1);
@loop:
  SR(C1);
  JC(Z,@last);
  JC(C,@add);
@shift:
  SL(a);
  JC(C,@overflow_loop);
  JP(@loop);
@add:
  ADD(C0,a);
  JC(C,@overflow_shift);
  JP(@shift);
@last:
  JC(NC,@zero);
  ADD(a,C0);
  JC(C,@overflow_done);
  MSC(O); MSR(ZSCO,ZSCO);
  END;
@zero:
  MOVI(a,0); MSR(ZSCO,ZSCO);
  END;

  # The product doesn't fit if an add carries, or if a bit is shifted out of
  # the register while bits of the value are left (as a later bit would have
  # added it). Finish without checking.
@overflow_loop:
  SR(C1);
  JC(Z,@overflow_last);
  JC(C,@overflow_add);
@overflow_shift:
  SL(a);
  JP(@overflow_loop);
@overflow_add:
  ADD(C0,a);
  JP(@overflow_shift);
@overflow_last:
  ADD(a,C0);
@overflow_done:
  MSS(CO); MSR(ZSCO,ZSCO);
}

instruction MUL.DW "$R, $m" {
  # As MUL.W, with the value in C2 and the product in C0 and C1.
  $LoadWord(C2);
@loop:
  SR(C2);
  JC(Z,@last);
  JC(C,@add);
@shift:
  SL(a0); RLC(a1);
  JC(C,@overflow_loop);
  JP(@loop);
@add:
  ADD(C0,a0); ADC(C1,a1);
  JC(C,@overflow_shift);
  JP(@shift);
@last:
  JC(NC,@zero);
  ADD(a0,C0); MSR(Z,Z); ADC(a1,C1);
  JC(C,@overflow_done);
  MSC(O); MSR(ZSCO,_SCO);
  END;
@zero:
  MOVI(a0,0); MOVI(a1,0); MSR(ZSCO,ZSCO);
  END;

@overflow_loop:
  SR(C2);
  JC(Z,@overflow_last);
  JC(C,@overflow_add);
@overflow_shift:
  SL(a0); RLC(a1);
  JP(@overflow_loop);
@overflow_add:
  ADD(C0,a0); ADC(C1,a1);
  JP(@overflow_shift);
@overflow_last:
  ADD(a0,C0); MSR(Z,Z); ADC(a1,C1);
@overflow_done:
  MSS(CO); MSR(ZSCO,_SCO);
}

################################################################################
## MULS <register>, <value>
##
## Cycles: 12-74
## ZSCO: XXXX
##
## Variants:
##    MULS.W <reg>, <reg>              (12-71 cycles)
##    MULS.W <reg>, <integer>          (12-71 cycles)
##    MULS.W <reg>, <word-address>     (13-74 cycles)
##
## Signed multiply of the register by a word value. The register gets the low
## bits of the product. The "C" and "O" flags are both set if the product
## doesn't fit in a signed word, and both cleared otherwise.
##
## The cycles depend on the value's absolute value as they do for MUL.W, with
## 4-8 more for the signs.
################################################################################

instruction MULS.W "$r, $m" {
  # Multiply the absolute values as MUL.W does, with the value in C2. C1 starts
  # as zero, so the first XOR copies the register to it and tests its sign, and
  # the second leaves whether the product is negative in its high bit.
  $LoadWord(C2);
  XOR(C1,a);
  JC(NS,@positive_register);
  NEG(a,a);
  XOR(C1,C2);
  JC(S,@loop);  # The value is positive
  JP(@negative_value);
@positive_register:
  XOR(C1,C2);
  JC(NS,@loop);  # The value is positive
@negative_value:
  NEG(C2,C2);
@loop:
  SR(C2);
  JC(Z,@last);
  JC(C,@add);
@shift:
  SL(a);
  JC(C,@overflow_loop);
  JP(@loop);
@add:
  ADD(C0,a);
  JC(C,@overflow_shift);
  JP(@shift);
@last:
  JC(NC,@zero);
  ADD(a,C0);
  JC(C,@overflow_done);

  # The product fits in a word. If it is less than 0x8000, it fits in a signed
  # word, negated if the product is negative.
  MSC(O); MSR(ZSCO,ZSCO);
  JC(S,@high);
  TST(C1);
  JC(S,@negate);
  END;
@negate:
  NEG(a,a); MSR(ZSCO,ZSCO);
  END;

  # Otherwise it only fits if the product is negative and it is 0x8000, which
  # negates to itself.
@high:
  TST(C1);
  JC(NS,@high_overflow);
  NEG(a,a);
  JC(NS,@signed_overflow);
  MSC(O); MSR(ZSCO,ZSCO);
  END;
@high_overflow:
  MSS(CO); MSR(CO,CO);
  END;
@zero:
  MOVI(a,0); MSR(ZSCO,ZSCO);
  END;

  # The product doesn't fit in a word, as in MUL.W.
@overflow_loop:
  SR(C2);
  JC(Z,@overflow_last);
  JC(C,@overflow_add);
@overflow_shift:
  SL(a);
  JP(@overflow_loop);
@overflow_add:
  ADD(C0,a);
  JP(@overflow_shift);
@overflow_last:
  ADD(a,C0);
@overflow_done:
  MSS(CO); MSR(ZSCO,ZSCO);
  TST(C1);
  JC(S,@negative_overflow);
  END;
@negative_overflow:
  NEG(a,a);
@signed_overflow:
  MSS(CO); MSR(ZSCO,ZSCO);
}

################################################################################
## DIV <register>, <value>
##
## Cycles: 5-172
## ZSCO: XX0X
##
## Variants:
##    DIV.W  <reg>, <reg>              (86 cycles)
##    DIV.W  <reg>, <integer>          (87 cycles)
##    DIV.W  <reg>, <word-address>     (88-90 cycles)
##    DIV.DW <dreg>, <reg>             (168 cycles)
##    DIV.DW <dreg>, <integer>         (169 cycles)
##    DIV.DW <dreg>, <word-address>    (170-172 cycles)
##
## Unsigned divide of the register by a word value. The register gets the
## quotient.
##
## Dividing by zero leaves the register unchanged, sets the "O" flag, and clears
## the others, taking 5-9 cycles. Otherwise, the "O" flag is cleared.
################################################################################

instruction DIV.W "$r, $m" {
  $GetWord;

  # C2 starts as zero, so OR copies the value to it (unless it is already C2),
  # as the value may be the register itself. It also tests the value, and
  # clears C.
  OR(C2,r);
  JC(Z,@error);

  # Shift the dividend left out of the register into the remainder in C1, and
  # subtract the value from the remainder wherever it fits. Each quotient bit
  # is left in C, and shifted into the register as the next dividend bit is
  # shifted out. A bit shifted out of the remainder means the value fits.
  MOVI(C0,16);
@loop:
  RLC(a); RLC(C1);
  JC(C,@subtract);
  CMP(C1,C2); MSX(C);
  JC(NC,@next);
@subtract:
  SUB(C1,C2); MSS(C);
@next:
  JD(C0,@loop);

  # The last RLC shifts out the zero C started as, so it leaves the flags
  # TST(a) would.
  RLC(a); MSR(ZSCO,ZSCO);
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

instruction DIV.DW "$R, $m" {
  $GetWord;
  OR(C2,r);  # As DIV.W, as the value may be part of the register
  JC(Z,@error);

  # Divide the high word as DIV.W does, then the low word the same way,
  # starting from the high word's remainder in C1.
  MOVI(C0,16);
@high:
  RLC(a1); RLC(C1);
  JC(C,@high_subtract);
  CMP(C1,C2); MSX(C);
  JC(NC,@high_next);
@high_subtract:
  SUB(C1,C2); MSS(C);
@high_next:
  JD(C0,@high);
  RLC(a1); MSR(ZSCO,ZSCO);

  MOVI(C0,16);
@low:
  RLC(a0); RLC(C1);
  JC(C,@low_subtract);
  CMP(C1,C2); MSX(C);
  JC(NC,@low_next);
@low_subtract:
  SUB(C1,C2); MSS(C);
@low_next:
  JD(C0,@low);
  RLC(a0); MSR(Z,_);
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

################################################################################
## DIVS <register>, <value>
##
## Cycles: 6-98
## ZSCO: XX0X
##
## Variants:
##    DIVS.W <reg>, <reg>              (91-94 cycles)
##    DIVS.W <reg>, <integer>          (92-95 cycles)
##    DIVS.W <reg>, <word-address>     (93-98 cycles)
##
## Signed divide of the register by a word value, rounding toward zero. The
## register gets the quotient. Each variant takes two more cycles when the
## value is negative.
##
## Dividing by zero leaves the register unchanged, sets the "O" flag, and clears
## the others, taking 6-10 cycles. So does dividing -32768 by -1, whose quotient
## doesn't fit, taking the most cycles of each variant. Otherwise, the "O" flag
## is cleared.
################################################################################

instruction DIVS.W "$r, $m" {
  $GetWord;

  # Divide the absolute values as DIV.W does. MB (which is restored when the
  # instruction ends) gets the register, and then the quotient's sign once the
  # value's sign is known. OR copies and tests the value as in DIV.W.
  MOV(MB,a);
  OR(C2,r);
  JC(Z,@error);
  JC(S,@negative_value);
  XOR(MB,C2);  # The quotient has the register's sign
  JC(NS,@divide);
  NEG(a,a);
  JP(@divide);
@negative_value:
  XOR(MB,C2);  # The quotient has the opposite of the register's sign
  JC(S,@abs_value);
  NEG(a,a);
@abs_value:
  NEG(C2,C2);

@divide:
  MOVI(C0,16);
@loop:
  RLC(a); RLC(C1);
  JC(C,@subtract);
  CMP(C1,C2); MSX(C);
  JC(NC,@next);
@subtract:
  SUB(C1,C2); MSS(C);
@next:
  JD(C0,@loop);
  RLC(a); MSR(ZSCO,ZSCO);
  JC(S,@too_big);
  TST(MB);
  JC(NS,@positive);
  NEG(a,a); MSR(ZSCO,ZSCO);
@positive:
  END;

  # A quotient of 32768 is already -32768 as a word, which fits if the quotient
  # is negative. Otherwise the register was -32768 (and still is), and the value
  # was -1.
@too_big:
  TST(MB);
  JC(NS,@error);
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

################################################################################
## MOD <register>, <value>
##
## Cycles: 5-171
## ZSCO: XX0X
##
## Variants:
##    MOD.W  <reg>, <reg>              (86 cycles)
##    MOD.W  <reg>, <integer>          (87 cycles)
##    MOD.W  <reg>, <word-address>     (88-90 cycles)
##    MOD.DW <dreg>, <reg>             (167 cycles)
##    MOD.DW <dreg>, <integer>         (168 cycles)
##    MOD.DW <dreg>, <word-address>    (169-171 cycles)
##
## Unsigned modulo of the register by a word value. The register gets the
## remainder, which always fits in a word (so MOD.DW clears the high word).
##
## Dividing by zero leaves the register unchanged, sets the "O" flag, and clears
## the others, taking 5-9 cycles. Otherwise, the "O" flag is cleared.
################################################################################

instruction MOD.W "$r, $m" {
  $GetWord;
  OR(C2,r);  # As DIV.W, as the value may be the register itself
  JC(Z,@error);

  # Divide as DIV.W does, leaving the remainder in C1. The quotient isn't
  # needed, so SL shifts zeros into the register, leaving it zero. Then OR
  # copies the remainder to it and tests it.
  MOVI(C0,16);
@loop:
  SL(a); RLC(C1);
  JC(C,@subtract);
  CMP(C1,C2);
  JC(C,@next);
@subtract:
  SUB(C1,C2);
@next:
  JD(C0,@loop);
  OR(a,C1); MSR(ZSCO,ZSCO);
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

instruction MOD.DW "$R, $m" {
  $GetWord;
  OR(C2,r);  # As DIV.W, as the value may be part of the register
  JC(Z,@error);

  # Divide as DIV.DW does, leaving the remainder in C1. The quotient isn't
  # needed, as in MOD.W, so both words are left zero.
  MOVI(C0,16);
@high:
  SL(a1); RLC(C1);
  JC(C,@high_subtract);
  CMP(C1,C2);
  JC(C,@high_next);
@high_subtract:
  SUB(C1,C2);
@high_next:
  JD(C0,@high);

  MOVI(C0,16);
@low:
  SL(a0); RLC(C1);
  JC(C,@low_subtract);
  CMP(C1,C2);
  JC(C,@low_next);
@low_subtract:
  SUB(C1,C2);
@low_next:
  JD(C0,@low);
  OR(a0,C1); MSC(S); MSR(ZSCO,ZSCO);  # S is clear, as the high word is zero
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

################################################################################
## DVMD <register>, <value>
##
## Cycles: 5-91
## ZSCO: XX0X
##
## Variants:
##    DVMD.W <dreg>, <reg>             (87 cycles)
##    DVMD.W <dreg>, <integer>         (88 cycles)
##    DVMD.W <dreg>, <word-address>    (89-91 cycles)
##
## Unsigned divide of the register's low word by a word value, getting the
## quotient in the low word and the remainder in the high word. The high word
## is ignored on input. The "Z" and "S" flags come from the quotient.
##
## Dividing by zero leaves the register unchanged, sets the "O" flag, and clears
## the others, taking 5-9 cycles. Otherwise, the "O" flag is cleared.
################################################################################

instruction DVMD.W "$R, $m" {
  $GetWord;
  OR(C2,r);  # As DIV.W, as the value may be part of the register
  JC(Z,@error);

  # Divide as DIV.W does, with the remainder in the high word.
  MOVI(a1,0);
  MOVI(C0,16);
@loop:
  RLC(a0); RLC(a1);
  JC(C,@subtract);
  CMP(a1,C2); MSX(C);
  JC(NC,@next);
@subtract:
  SUB(a1,C2); MSS(C);
@next:
  JD(C0,@loop);
  RLC(a0); MSR(ZSCO,ZSCO);
  END;

@error:
  MSC(ZSC); MSS(O); MSR(ZSCO,ZSCO);
}

################################################################################
## NOT <register>
##
## Cycles: 5-9
## ZSCO: XX00
##
## Variants:
##    NOT.W <reg>
##    NOT.D <dreg>
##
## Bitwise NOT of the value in the specified register.
################################################################################

instruction NOT.W "$r" {
  UL;
  NOT(a,a); MSR(ZSCO,ZSCO);
}

instruction NOT.D "$R" {
  UL;
  NOT(a0,a0); MSR(Z,Z);
  NOT(a1,a1); MSR(ZSCO,_SCO);
}

################################################################################
## AND <register>, <value>
##
## Cycles: 4+
## ZSCO: XX00
##
## Variants:
##    AND.W <reg>, <word-value>
##    AND.D <dreg>, <dword-value>
##
## Bitwise AND a value to the specified register.
################################################################################

instruction AND.W "$r, $m" {
  $GetWord;
  AND(a,r);
  MSR(ZSCO,ZSCO);
}

instruction AND.D "$R, $m" {
  $GetDword;
  AND(a0,r0);
  MSR(Z,Z);
  AND(a1,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## OR <register>, <value>
##
## Cycles: 4+
## ZSCO: XX00
##
## Variants:
##    OR.W <reg>, <word-value>
##    OR.D <dreg>, <dword-value>
##
## Bitwise OR a value to the specified register.
################################################################################

instruction OR.W "$r, $m" {
  $GetWord;
  OR(a,r);
  MSR(ZSCO,ZSCO);
}

instruction OR.D "$R, $m" {
  $GetDword;
  OR(a0,r0);
  MSR(Z,Z);
  OR(a1,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## XOR <register>, <value>
##
## Cycles: 4+
## ZSCO: XX00
##
## Variants:
##    XOR.W <reg>, <word-value>
##    XOR.D <dreg>, <dword-value>
##
## Bitwise XOR a value to the specified register.
################################################################################

instruction XOR.W "$r, $m" {
  $GetWord;
  XOR(a,r);
  MSR(ZSCO,ZSCO);
}

instruction XOR.D "$R, $m" {
  $GetDword;
  XOR(a0,r0);
  MSR(Z,Z);
  XOR(a1,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## SHL <register>, <value>
##
## Cycles: 5+
## ZSCO: XXX0
##
## Variants:
##    SHL.W <reg>, <reg>
##    SHL.W <reg>, <1..16>
##    SHL.D <dreg>, <reg>
##    SHL.D <dreg>, <1..32>
##
## Logical shift left of the register by the specified number of bits. The last
## bit shifted out sets the value of the "C" flag.
################################################################################

macro(bits:5) LogicalShiftLeft16(p) {
  code "$r" {
    # Shift zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Shift > 16 bits?
    CMPI(m,17);
    JC(NC,@max);

    # Shift 1-16 bits
  @shift:
    SL(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

  @max:
    MOVI(p,0);
    MSC(SCO); MSS(Z); MSR(SCO,Z);
    END;

  @zero:
    TST(p); MSR(ZSCO,ZSCO);
  }

  code "1" {
    SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    SL(p); SL(p); SL(p); SL(p); SL(p); SL(p); SL(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    SR(p); MOVI(p,0);
    MSS(Z); MSR(ZSCO,ZSCO);
  }
}

instruction SHL.W "$r, $m" {
  UL; $LogicalShiftLeft16(a);
}

macro(bits:6) LogicalShiftLeft32(P) {
  code "$r" {
    # Shift zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Shift 16 bits or more? The low word moves to the high word first, so
    # only the rest are shifted, a word at a time.
    CMPI(m,16);
    JC(Z,@sixteen);
    JC(NC,@high);

    # Shift 1-15 bits
  @shift:
    SL(p0); MSR(Z,Z); RLC(p1);
    JD(C2,@shift);
    MSR(ZSCO,SCO);
    END;

    # Shift 17-32 bits
  @high:
    CMPI(m,33);
    JC(NC,@max);
    MOV(p1,p0); MOVI(p0,0); ADDI(C2,-16);
  @shift_high:
    SL(p1);
    JD(C2,@shift_high);
    MSR(ZSCO,ZSCO);
    END;

  @sixteen:  # As code "16"
    SR(p1); MSR(C,C);  # The last bit shifted out
    MOV(p1,p0); MOVI(p0,0);
    TST(p1); MSR(ZSO,ZSO);
    END;

  @max:
    MOVI(p0,0); MOVI(p1,0);
    MSC(SCO); MSS(Z); MSR(SCO,Z);
    END;

  @zero:
    TST(p0); MSR(Z,Z); TST(p1); MSR(ZCSO,CSO);
  }

  code "1" {
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "2" {
    SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "3" {
    SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "4" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "5" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);

   SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "6" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "7" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "8" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "9" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);

   SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "10" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "11" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "12" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "13" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);

   SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "14" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "15" {
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); RLC(p1); SL(p0); RLC(p1);
    SL(p0); MSR(Z,Z); RLC(p1);
    MSR(ZSCO,SCO);
  }
  code "16" {
    SR(p1); MSR(C,C); MOV(p1,p0); MOVI(p0,0);
    TST(p1); MSR(ZSO,ZSO);
  }
  code "17" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "18" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "19" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1); SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "20" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1); SL(p1); SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "21" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1); SL(p1); SL(p1); SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "22" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1); SL(p1); SL(p1); SL(p1); SL(p1);
    MSR(ZSCO,ZSCO);
  }
  code "23" {
    MOV(p1,p0); MOVI(p0,0);
    SL(p1); SL(p1); SL(p1); SL(p1); SL(p1); SL(p1); SL(p1);
