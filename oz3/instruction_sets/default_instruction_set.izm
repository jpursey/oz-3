    MSC(S); MSR(ZSCO,SCO);
  }
  code "5" {
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);

   SR(p1); MSR(Z,Z); RRC(p0);
    MSC(S); MSR(ZSCO,SCO);
  }
  code "6" {
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0);
    SR(p1); MSR(Z,Z); RRC(p0);
    MSC(S); MSR(ZSCO,SCO);
  }
  code "7" {
