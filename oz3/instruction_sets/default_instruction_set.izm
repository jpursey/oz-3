    SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0);
    MSR(ZSCO,ZSCO);
  }
  code "25" {
    MOV(p0,p1); MOVI(p1,0);
    SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0); SR(p0);
