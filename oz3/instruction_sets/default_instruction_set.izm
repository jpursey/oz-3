################################################################################
## SRA <register>, <value>
##
## Cycles: 5+
## ZSCO: XXX0
##
## Variants:
##    SRA.W <reg>, <reg>
##    SRA.W <reg>, <1..16>
##    SRA.D <dreg>, <reg>
##    SRA.D <dreg>, <1..32>
##
## Arithmetic shift right of the register by the specified number of bits.  The
## last bit shifted out sets the value of the "C" flag.
################################################################################

macro(bits:5) ArithmeticShiftRight16(p) {
  code "$r" {
    # Shift zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Shift > 16 bits?
    CMPI(m,17);
    JC(NC,@max);

    # Shift 1-16 bits
  @shift:
    SRA(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

  @max:
    TST(p);
    JC(S,@signed_max);
    MOVI(p,0);
    MSC(SCO); MSS(Z); MSR(SCO,Z);
    END;

  @signed_max:
    MOVI(p,-1);
    MSC(ZO); MSS(SC); MSR(ZO,SC);
    END;

  @zero:
    TST(p); MSR(ZSCO,ZSCO);
  }

  code "1" {
    SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p); SRA(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    SL(p);
    JC(C,@negative);
    MOVI(p,0);
    MSS(Z); MSC(S); MSR(ZSCO,ZSCO);
    END;
  @negative:
    MOVI(p,-1);
    MSS(S); MSC(Z); MSR(ZSCO,ZSCO);
  }
}

instruction SRA.W "$r, $m" {
  UL; $ArithmeticShiftRight16(a);
}

macro(bits:6) ArithmeticShiftRight32(P) {
  code "$r" {
    # Shift zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Shift 16 bits or more? The high word moves to the low word first, so
    # only the rest are shifted, a word at a time.
    CMPI(m,16);
    JC(Z,@sixteen);
    JC(NC,@high);

    # Shift 1-15 bits
  @shift:
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    JD(C2,@shift);
    MSR(ZCO,CO);
    END;

    # Shift 17-32 bits. SL then SBC fills the high word with its sign bit, as
    # SBC subtracts C (the sign) from zero.
  @high:
    CMPI(m,33);
    JC(NC,@max);
    MOV(p0,p1); SL(p1); SBC(p1,p1); ADDI(C2,-16);
  @shift_high:
    SRA(p0);
    JD(C2,@shift_high);
    MSR(ZSCO,ZSCO);
    END;

  @sixteen:  # As code "16"
    SL(p0); MSR(C,C);  # The last bit shifted out
    MOV(p0,p1);
    TST(p0); MSR(ZSO,ZSO);
    JC(S,@negative_sixteen);
    MOVI(p1,0);
    END;
  @negative_sixteen:
    MOVI(p1,-1);
    END;

  @max:
    TST(p1);
    JC(S,@signed_max);
    MOVI(p0,0); MOVI(p1,0);
    MSC(SCO); MSS(Z); MSR(SCO,Z);
    END;

  @signed_max:
    MOVI(p0,-1); MOVI(p1,-1);
    MSC(ZO); MSS(SC); MSR(ZO,SC);
    END;

  @zero:
    TST(p0); MSR(Z,Z); TST(p1); MSR(ZCSO,CSO);
  }

  code "1" {
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "2" {
    SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "3" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "4" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "5" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "6" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "7" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "8" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "9" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "10" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "11" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "12" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "13" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "14" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "15" {
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); RRC(p0); SRA(p1); RRC(p0);
    SRA(p1); MSR(ZS,ZS); RRC(p0);
    MSR(ZCO,CO);
  }
  code "16" {
    SL(p0); MSR(C,C); MOV(p0,p1);
    TST(p0); MSR(ZSO,ZSO);
    JC(S,@negative);
    MOVI(p1,0);
    END;
  @negative:
    MOVI(p1,-1);
  }

  # The high word moves to the low word, and SL then SBC fills the high word
  # with its sign bit (SBC subtracts C from zero), so only the low word needs
  # shifting.
  code "17" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "18" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "19" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "20" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "21" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "22" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "23" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "24" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "25" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "26" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "27" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "28" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "29" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "30" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "31" {
    MOV(p0,p1); SL(p1); SBC(p1,p1);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0); SRA(p0);
    MSR(ZSCO,ZSCO);
  }
  code "32" {
    SL(p1);
    JC(C,@negative);
    MOVI(p0,0); MOVI(p1,0);
    MSC(SCO); MSS(Z); MSR(SCO,Z);
    END;
  @negative:
    MOVI(p0,-1); MOVI(p1,-1);
    MSC(ZO); MSS(SC); MSR(ZO,SC);
  }
}

instruction SRA.D "$R, $m" {
  UL; $ArithmeticShiftRight32(A);
}

################################################################################
## ROL <register>, <value>
##
## Cycles: 5+
## ZSCO: XXX0
##
## Variants:
##    ROL.W <reg>, <reg>
##    ROL.W <reg>, <1..16>
##    ROL.D <dreg>, <reg>
##    ROL.D <dreg>, <1..32>
##
## Rotate left of the register by the specified number of bits. The last bit
## shifted sets the value of the "C" flag.
################################################################################

macro(bits:5) RotateLeft16(p) {
  code "$r" {
    # Rotate a multiple of 16 bits (including zero)?
    MOVI(C2,15); AND(C2,m);
    JC(Z,@full);

    # Rotate 1-15 bits
  @shift:
    RL(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

    # Rotating zero bits clears C. Otherwise, RR then RL leaves the register
    # as it was, with the last bit rotated in C.
  @full:
    TST(m);
    JC(Z,@zero);
    RR(p); RL(p); MSR(ZSCO,ZSCO);
    END;

  @zero:
    TST(p); MSR(ZSCO,ZSCO);
  }

  code "1" {
    RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    RL(p); RL(p); RL(p); RL(p); RL(p); RL(p); RL(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    RR(p); RL(p); MSR(ZSCO,ZSCO);  # As "$r" for 16
  }
}

instruction ROL.W "$r, $m" {
  UL; $RotateLeft16(a);
}

macro(bits:6) GetRotateCount32:r {
  code:m "$r" {}
  code:C0 "1" { MOVI(C0,1); }
  code:C0 "2" { MOVI(C0,2); }
  code:C0 "3" { MOVI(C0,3); }
  code:C0 "4" { MOVI(C0,4); }
  code:C0 "5" { MOVI(C0,5); }
  code:C0 "6" { MOVI(C0,6); }
  code:C0 "7" { MOVI(C0,7); }
  code:C0 "8" { MOVI(C0,8); }
  code:C0 "9" { MOVI(C0,9); }
  code:C0 "10" { MOVI(C0,10); }
  code:C0 "11" { MOVI(C0,11); }
  code:C0 "12" { MOVI(C0,12); }
  code:C0 "13" { MOVI(C0,13); }
  code:C0 "14" { MOVI(C0,14); }
  code:C0 "15" { MOVI(C0,15); }
  code:C0 "16" { MOVI(C0,16); }
  code:C0 "17" { MOVI(C0,17); }
  code:C0 "18" { MOVI(C0,18); }
  code:C0 "19" { MOVI(C0,19); }
  code:C0 "20" { MOVI(C0,20); }
  code:C0 "21" { MOVI(C0,21); }
  code:C0 "22" { MOVI(C0,22); }
  code:C0 "23" { MOVI(C0,23); }
  code:C0 "24" { MOVI(C0,24); }
  code:C0 "25" { MOVI(C0,25); }
  code:C0 "26" { MOVI(C0,26); }
  code:C0 "27" { MOVI(C0,27); }
  code:C0 "28" { MOVI(C0,28); }
  code:C0 "29" { MOVI(C0,29); }
  code:C0 "30" { MOVI(C0,30); }
  code:C0 "31" { MOVI(C0,31); }
  code:C0 "32" { MOVI(C0,32); }
}

instruction ROL.D "$R, $m" {
  UL;
  $GetRotateCount32;

  # Rotate a multiple of 32 bits (including zero)?
  MOVI(C2,31); AND(C2,r);
  JC(Z,@full);

  # Rotate 16 bits or more? Swapping the words rotates 16, so only the rest
  # rotate a bit at a time.
  CMPI(C2,16);
  JC(C,@shift);
  MOV(C0,a0); MOV(a0,a1); MOV(a1,C0);
  ADDI(C2,-16);
  JC(Z,@last_bit);

  # Rotate 1-15 bits. The bit shifted out of the high word is added into the
  # low bit of the low word, which SL cleared (C1 is zero). MSR keeps the high
  # word's flags and the bit rotated, and Z is cleared after if the low word
  # isn't zero.
@shift:
  SL(a0); RLC(a1); MSR(ZSC,ZSC); ADC(a0,C1);
  JD(C2,@shift);
  MSR(ZO,_);
  END;

  # Rotating zero bits clears C. Otherwise, the last bit rotated is the low bit
  # of the low word, which RR then RL leaves in C.
@full:
  TST(r);
  JC(Z,@zero);
@last_bit:
  RR(a0); RL(a0); MSR(ZC,ZC);
  TST(a1); MSR(ZSO,SO);
  END;

@zero:
  TST(a0); MSR(Z,Z); TST(a1); MSR(ZCSO,CSO);
}

################################################################################
## ROR <register>, <value>
##
## Cycles: 5+
## ZSCO: XXX0
##
## Variants:
##    ROR.W <reg>, <reg>
##    ROR.W <reg>, <1..16>
##    ROR.D <dreg>, <reg>
##    ROR.D <dreg>, <1..32>
##
## Rotate right of the register by the specified number of bits. The last bit
## shifted sets the value of the "C" flag.
################################################################################

macro(bits:5) RotateRight16(p) {
  code "$r" {
    # Rotate a multiple of 16 bits (including zero)?
    MOVI(C2,15); AND(C2,m);
    JC(Z,@full);

    # Rotate 1-15 bits
  @shift:
    RR(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

    # Rotating zero bits clears C. Otherwise, RL then RR leaves the register
    # as it was, with the last bit rotated in C.
  @full:
    TST(m);
    JC(Z,@zero);
    RL(p); RR(p); MSR(ZSCO,ZSCO);
    END;

  @zero:
    TST(p); MSR(ZSCO,ZSCO);
  }

  code "1" {
    RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    RR(p); RR(p); RR(p); RR(p); RR(p); RR(p); RR(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    RL(p); RR(p); MSR(ZSCO,ZSCO);  # As "$r" for 16
  }
}

instruction ROR.W "$r, $m" {
  UL; $RotateRight16(a);
}

instruction ROR.D "$R, $m" {
  UL;
  $GetRotateCount32;

  # Rotate a multiple of 32 bits (including zero)?
  MOVI(C2,31); AND(C2,r);
  JC(Z,@full);

  # Rotate 16 bits or more? Swapping the words rotates 16, so only the rest
  # rotate a bit at a time.
  CMPI(C2,16);
  JC(C,@rotate);
  MOV(C0,a0); MOV(a0,a1); MOV(a1,C0);
  ADDI(C2,-16);
  JC(Z,@last_bit);

  # Rotate 1-15 bits. The bit shifted out of the high word is ORed into the
  # high bit of the low word, which SR cleared. MSR keeps the bit rotated and
  # the high word's flags, and Z is cleared after if the low word isn't zero.
@rotate:
  MVNI(C1:3,8);  # Set C1 to 0x8000
@shift:
  SR(a0); MSR(C,C); RRC(a1); MSR(ZS,ZS);
  JC(NC,@next);
  OR(a0,C1);
@next:
  JD(C2,@shift);
  TST(a0); MSR(ZO,_);
  END;

  # Rotating zero bits clears C. Otherwise, the last bit rotated is the high
  # bit of the high word, which RL then RR leaves in C.
@full:
  TST(r);
  JC(Z,@zero);
@last_bit:
  RL(a1); RR(a1); MSR(ZSC,ZSC);
  TST(a0); MSR(ZO,_);
  END;

@zero:
  TST(a0); MSR(Z,Z); TST(a1); MSR(ZCSO,CSO);
}

################################################################################
## RLC <register>, <value>
##
## Cycles: 4-137
## ZSCO: XXX0
##
## Variants:
##    RLC.W <reg>, <reg>      (6-65 cycles)
##    RLC.W <reg>, <1..16>    (4-19 cycles)
##    RLC.D <dreg>, <reg>     (7-137 cycles)
##    RLC.D <dreg>, <1..32>   (10-103 cycles)
##
## Rotate left of the register through the "C" flag by the specified number of
## bits. The last bit shifted sets the value of the "C" flag.
##
## Rotating 17 bits (33 for a dword) through the "C" flag is a full turn, so a
## count from a register of 17 (33) or more is reduced modulo 17 (33) first.
## This adds a fixed 27 cycles (35 for a dword).
################################################################################

macro(bits:5) RotateLeft16ThroughCarry(p) {
  code "$r" {
    # Rotate zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Rotate 17+ bits?
    CMPI(C2,17);
    JC(NC,@reduce);

    # Rotate 1-16 bits
  @rotate:
    MSM(C,ST);
  @shift:
    RLC(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

    # Reduce modulo 17. As 256 is 1 modulo 17, add the high byte to the low
    # byte (at most 510), then subtract each of 17<<4 down to 17 that fits.
    # Shifting out the low bit of 17 ends the loop. C0 starts at zero.
  @reduce:
    MVB(C0:L,C2:H); MVBI(C2:H,0); ADD(C2,C0);
    MVBI(C0:H,1); MVBI(C0:L,16);  # Set C0 to 0x0110 (17<<4)
  @divide:
    CMP(C2,C0);
    JC(C,@next);
    SUB(C2,C0);
  @next:
    SR(C0);
    JC(NC,@divide);
    TST(C2);
    JC(NZ,@rotate);

  @zero:
    TST(p); MSR(ZSO,ZSO);
  }

  code "1" {
    RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p); RLC(p);
    MSR(ZSCO,ZSCO);
  }
}

instruction RLC.W "$r, $m" {
  UL; $RotateLeft16ThroughCarry(a);
}

instruction RLC.D "$R, $m" {
  UL;
  $GetRotateCount32;

  # Rotate zero bits? C2 starts as zero, so OR copies the count and tests it.
  OR(C2,r);
  JC(Z,@zero);

  # Rotate 33+ bits?
  CMPI(C2,33);
  JC(NC,@reduce);

  # Rotate 1-32 bits
@rotate:
  MSM(C,ST);
@shift:
  RLC(a0); MSR(Z,Z); RLC(a1);
  JD(C2,@shift);
  MSR(ZSCO,SCO);
  END;

  # Reduce modulo 33. As 1024 is 1 modulo 33, add the high 6 bits to the low
  # 10 bits (at most 1086), then subtract each of 33<<5 down to 33 that fits.
  # Shifting out the low bit of 33 ends the loop. C0 starts at zero.
@reduce:
  MVB(C0:L,C2:H); SR(C0); SR(C0);         # Set C0 to the high 6 bits
  MOVI(C1,-1); MVBI(C1:H,3); AND(C2,C1);  # Set C2 to the low 10 bits
  ADD(C2,C0);
  MVBI(C0:H,4); MVBI(C0:L,32);  # Set C0 to 0x0420 (33<<5)
@divide:
  CMP(C2,C0);
  JC(C,@next);
  SUB(C2,C0);
@next:
  SR(C0);
  JC(NC,@divide);
  TST(C2);
  JC(NZ,@rotate);

@zero:
  TST(a0); MSR(Z,Z); TST(a1); MSR(ZSO,SO);
}

################################################################################
## RRC <register>, <value>
##
## Cycles: 4-137
## ZSCO: XXX0
##
## Variants:
##    RRC.W <reg>, <reg>      (6-65 cycles)
##    RRC.W <reg>, <1..16>    (4-19 cycles)
##    RRC.D <dreg>, <reg>     (7-137 cycles)
##    RRC.D <dreg>, <1..32>   (10-103 cycles)
##
## Rotate right of the register through the "C" flag by the specified number of
## bits. The last bit shifted sets the value of the "C" flag.
##
## Rotating 17 bits (33 for a dword) through the "C" flag is a full turn, so a
## count from a register of 17 (33) or more is reduced modulo 17 (33) first.
## This adds a fixed 27 cycles (35 for a dword).
################################################################################

macro(bits:5) RotateRight16ThroughCarry(p) {
  code "$r" {
    # Rotate zero bits? C2 starts as zero, so OR copies the count and tests it.
    OR(C2,m);
    JC(Z,@zero);

    # Rotate 17+ bits?
    CMPI(C2,17);
    JC(NC,@reduce);

    # Rotate 1-16 bits
  @rotate:
    MSM(C,ST);
  @shift:
    RRC(p);
    JD(C2,@shift);
    MSR(ZSCO,ZSCO);
    END;

    # Reduce modulo 17. As 256 is 1 modulo 17, add the high byte to the low
    # byte (at most 510), then subtract each of 17<<4 down to 17 that fits.
    # Shifting out the low bit of 17 ends the loop. C0 starts at zero.
  @reduce:
    MVB(C0:L,C2:H); MVBI(C2:H,0); ADD(C2,C0);
    MVBI(C0:H,1); MVBI(C0:L,16);  # Set C0 to 0x0110 (17<<4)
  @divide:
    CMP(C2,C0);
    JC(C,@next);
    SUB(C2,C0);
  @next:
    SR(C0);
    JC(NC,@divide);
    TST(C2);
    JC(NZ,@rotate);

  @zero:
    TST(p); MSR(ZSO,ZSO);
  }

  code "1" {
    RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "2" {
    RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "3" {
    RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "4" {
    RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "5" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "6" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "7" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "8" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "9" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "10" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "11" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "12" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "13" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "14" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "15" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
  code "16" {
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p); RRC(p);
    MSR(ZSCO,ZSCO);
  }
}

instruction RRC.W "$r, $m" {
  UL; $RotateRight16ThroughCarry(a);
}

instruction RRC.D "$R, $m" {
  UL;
  $GetRotateCount32;

  # Rotate zero bits? C2 starts as zero, so OR copies the count and tests it.
  OR(C2,r);
  JC(Z,@zero);

  # Rotate 33+ bits?
  CMPI(C2,33);
  JC(NC,@reduce);

  # Rotate 1-32 bits
@rotate:
  MSM(C,ST);
@shift:
  RRC(a1); MSR(ZS,ZS); RRC(a0);
  JD(C2,@shift);
  MSR(ZCO,CO);
  END;

  # Reduce modulo 33. As 1024 is 1 modulo 33, add the high 6 bits to the low
  # 10 bits (at most 1086), then subtract each of 33<<5 down to 33 that fits.
  # Shifting out the low bit of 33 ends the loop. C0 starts at zero.
@reduce:
  MVB(C0:L,C2:H); SR(C0); SR(C0);         # Set C0 to the high 6 bits
  MOVI(C1,-1); MVBI(C1:H,3); AND(C2,C1);  # Set C2 to the low 10 bits
  ADD(C2,C0);
  MVBI(C0:H,4); MVBI(C0:L,32);  # Set C0 to 0x0420 (33<<5)
@divide:
  CMP(C2,C0);
  JC(C,@next);
  SUB(C2,C0);
@next:
  SR(C0);
  JC(NC,@divide);
  TST(C2);
  JC(NZ,@rotate);

@zero:
  TST(a0); MSR(Z,Z); TST(a1); MSR(ZSO,SO);
}

################################################################################
## CLRB <register>, <bit-position>
##
## Cycles: 6+
## ZSCO: ----
##
## Variants:
##    CLRB.W <reg>, <word-value>
##    CLRB.D <dreg>, <dword-value>
##
## Clears bit in the specified register.
################################################################################

instruction CLRB.W "$r, $m" {
  $Get16BitMask;
  NOT(r,r);
  AND(a,r);
}

instruction CLRB.D "$R, $m" {
  $Get32BitMask;
  NOT(r0,r0);
  NOT(r1,r1);
  AND(a0,r0);
  AND(a1,r1);
}

################################################################################
## SETB <register>, <bit-position>
##
## Cycles: 5+
## ZSCO: ----
##
## Variants:
##    SETB.W <reg>, <word-value>
##    SETB.D <dreg>, <dword-value>
##
## Sets bit in the specified register.
################################################################################

instruction SETB.W "$r, $m" {
  $Get16BitMask;
  OR(a,r);
}

instruction SETB.D "$R, $m" {
  $Get32BitMask;
  OR(a0,r0);
  OR(a1,r1);
}

################################################################################
## NOTB <register>, <bit-position>
##
## Cycles: 5+
## ZSCO: ----
##
## Variants:
##    NOTB.W <reg>, <word-value>
##    NOTB.D <dreg>, <dword-value>
##
## Toggles bit in the specified register.
################################################################################

instruction NOTB.W "$r, $m" {
  $Get16BitMask;
  XOR(a,r);
}

instruction NOTB.D "$R, $m" {
  $Get32BitMask;
  XOR(a0,r0);
  XOR(a1,r1);
}

################################################################################
## TSTB <register>, <bit-position>
##
## Cycles: 5+
## ZSCO: X---
##
## Variants:
##    TSTB.W <reg>, <word-value>
##    TSTB.D <dreg>, <dword-value>
##
## Tests a bit in the specified register, setting Z if it is zero.
################################################################################

instruction TSTB.W "$r, $m" {
  $Get16BitMask;
  MSK(r,a);
  MSR(Z,Z);
}

instruction TSTB.D "$R, $m" {
  $Get32BitMask;
  MSK(r0,a0);
  MSR(Z,Z);
  MSK(r1,a1);
  MSR(Z,_);
}

################################################################################
## CLRF <flags>
##
## Cycles: 3
## ZSCO: ????
##
## Clears the specified status flags.
################################################################################

instruction CLRF "$#4" {
  MSC(a); MSR(a,_); UL;
}

################################################################################
## SETF <flags>
##
## Cycles: 3
## ZSCO: ????
##
## Sets the specified status flags.
################################################################################

instruction SETF "$#4" {
  MSS(a); MSR(_,a); UL;
}

################################################################################
## NOTF <flags>
##
## Cycles: 3
## ZSCO: ????
##
## Performs a bitwise NOT to the specified status flags.
################################################################################

instruction NOTF "$#4" {
  MSX(a); MSR(a,a); UL;
}

################################################################################
## TST <value>
##
## Cycles: 4+
## ZSCO: XX00
##
## Variants:
##    TST.W <word-value>
##    TST.D <dword-value>
##
## Tests a value setting flags.
################################################################################

instruction TST.W "$m" {
  $GetWord;
  TST(r);
  MSR(ZSCO,ZSCO);
}

instruction TST.D "$m" {
  $GetDword;
  TST(r0);
  MSR(Z,Z);
  TST(r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## CMP <register> <value>
##
## Cycles: 4+
## ZSCO: XXXX
##
## Variants:
##    CMP.W <reg> <word-value>
##    CMP.D <dreg> <dword-value>
##
## Subtracts <value> from <register> setting flags, but not updating <register>.
################################################################################

instruction CMP.W "$r, $m" {
  $GetWord;
  CMP(a,r);
  MSR(ZSCO,ZSCO);
}

instruction CMP.D "$R, $m" {
  $GetDword;
  CMP(a0,r0);
  MSR(Z,Z);
  MOV(C2,a1);
  SBC(C2,r1);
  MSR(ZSCO,_SCO);
}

################################################################################
## CPI <register>, (<address-register>)
##
## Cycles: 6
## ZSCO: XXXX
##
## Compares the register with the word at the address in the address register
## (in the memory bank that register implies), setting flags as CMP.W does,
## then steps the address register up by one.
################################################################################

instruction CPI "$r, ($r)" {
  UL;

  # Compares before stepping, as the address register may be the register.
  LKR(b); ADR(b); LD(C0); CMP(a,C0); LAD(b); UL;
  MSR(ZSCO,ZSCO);
}

################################################################################
## CPD <register>, (<address-register>)
##
## Cycles: 7
## ZSCO: XXXX
##
## Compares the register with the word at the address in the address register
## (in the memory bank that register implies), setting flags as CMP.W does,
## then steps the address register down by one.
################################################################################

instruction CPD "$r, ($r)" {
  UL;
  LKR(b); ADR(b); LD(C0); CMP(a,C0); UL;  # As CPI
  MSR(ZSCO,ZSCO);
  ADDI(b,-1);
}

################################################################################
## CPIR <register>, (<address-register>)
##
## Cycles: 5 or 8-9 per word
## ZSCO: XXXX
##
## CPI, decrementing the count in R7 for each word, repeated until the word
## matches (setting the "Z" flag) or R7 is 0. Each execution compares one word,
## and then executes the instruction again if it isn't done, so interrupts are
## handled between words. Each word takes 9 cycles, except the last (when R7
## reaches 0), which takes 8.
##
## If R7 is 0, nothing is compared, the "Z", "S", "C", and "O" flags are
## cleared, and it takes 5 cycles.
################################################################################

instruction CPIR "$r, ($r)" {
  UL;
  TST(R7);
  JC(Z,@empty);
  LKR(b); ADR(b); LD(C0); CMP(a,C0); LAD(b); UL;  # As CPI
  MSR(ZSCO,ZSCO);

  # JD doesn't change the flags, so they still say whether the word matched.
  JD(R7,@more);
  END;
@more:
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;

@empty:
  MSC(ZSCO); MSR(ZSCO,ZSCO);
}

################################################################################
## CPDR <register>, (<address-register>)
##
## Cycles: 5 or 9-10 per word
## ZSCO: XXXX
##
## CPD, decrementing the count in R7 for each word, repeated until the word
## matches (setting the "Z" flag) or R7 is 0. Each execution compares one word,
## and then executes the instruction again if it isn't done, so interrupts are
## handled between words. Each word takes 10 cycles, except the last (when R7
## reaches 0), which takes 9.
##
## If R7 is 0, nothing is compared, the "Z", "S", "C", and "O" flags are
## cleared, and it takes 5 cycles.
################################################################################

instruction CPDR "$r, ($r)" {
  UL;
  TST(R7);
  JC(Z,@empty);
  LKR(b); ADR(b); LD(C0); CMP(a,C0); UL;  # As CPI
  MSR(ZSCO,ZSCO);

  # As CPIR, stepping the address down with JD (which always lands on the next
  # microcode), as ADDI would change the flags.
  JD(b,@stepped);
@stepped:
  JD(R7,@more);
  END;
@more:
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;

@empty:
  MSC(ZSCO); MSR(ZSCO,ZSCO);
}

################################################################################
## JP <address>
##
## Cycles: 4+
## ZSCO: ----
##
## Sets IP to the specified address.
################################################################################

instruction JP "$m" {
  # The fetch phase may load straight into any register (see the microcode
  # reference), so the address goes straight into IP.
  $LoadWord(IP);
}

################################################################################
## JPR <relative-address>
##
## Cycles: 4+
## ZSCO: ----
##
## Adds the specified relative address to IP.
################################################################################

instruction JPR "$m" {
  $GetWord;
  ADD(IP,r);
}

################################################################################
## JC <condition> <address>
##
## Cycles: 3+
## ZSCO: ----
##
## Sets IP to the specified address if the specified condition is true.
################################################################################

instruction JC "$#3, $m" {
  $GetWord;
  JC(a,@jump);
  END;
@jump:
  MOV(IP,r);
}

################################################################################
## JCR <condition> <relative-address>
##
## Cycles: 3+
## ZSCO: ----
##
## Adds the specified relative address to IP if the specified condition is true.
################################################################################

instruction JCR "$#3, $m" {
  $GetWord;
  JC(a,@jump);
  END;
@jump:
  ADD(IP,r);
}

################################################################################
## JD <register> <address>
##
## Cycles: 4-9
## ZSCO: ----
##
## Variants:
##    JD <reg>, <reg>              (4-5 cycles)
##    JD <reg>, <integer>          (5-6 cycles)
##    JD <reg>, <word-address>     (6-9 cycles)
##
## Decrements the register, then sets IP to the specified address if the
## register is not zero. A register of zero wraps to 0xFFFF and jumps. Each
## variant takes one more cycle when it jumps.
##
## An address in memory is read before the register is decremented, even when
## the register locates it. An address that is the register itself is the
## decremented value.
################################################################################

instruction JD "$r, $m" {
  $GetWord;
  JD(a,@jump);
  END;
@jump:
  MOV(IP,r);
}

################################################################################
## JDR <register> <relative-address>
##
## Cycles: 4-9
## ZSCO: ----
##
## Variants:
##    JDR <reg>, <reg>             (4-5 cycles)
##    JDR <reg>, <integer>         (5-6 cycles)
##    JDR <reg>, <word-address>    (6-9 cycles)
##
## Decrements the register, then adds the specified relative address to IP if
## the register is not zero. A register of zero wraps to 0xFFFF and jumps. Each
## variant takes one more cycle when it jumps.
##
## An address in memory is read before the register is decremented, even when
## the register locates it. An address that is the register itself is the
## decremented value.
################################################################################

instruction JDR "$r, $m" {
  $GetWord;
  JD(a,@jump);
  END;
@jump:
  ADD(IP,r);
}

################################################################################
## CALL <address>
##
## Cycles: 6+
## ZSCO: ----
##
## Pushes IP onto the stack and sets IP to the specified address.
################################################################################

instruction CALL "$m" {
  $GetWord;
  LK(STACK); ADR(SP); STP(IP); LAD(SP); UL;
  MOV(IP,r);
}

################################################################################
## CALLR <relative-address>
##
## Cycles: 6+
## ZSCO: ----
##
## Pushes IP onto the stack and adds the specified relative address to IP.
################################################################################

instruction CALLR "$m" {
  $GetWord;
  LK(STACK); ADR(SP); STP(IP); LAD(SP); UL;
  ADD(IP,r);
}

################################################################################
## FBGN
##
## Cycles: 6
## ZSCO: ----
##
## Pushes FP onto the stack and sets it to SP.
################################################################################

instruction FBGN {
  UL;
  LK(STACK); ADR(SP); STP(FP); LAD(SP); UL;
  MOV(FP,SP);
}

################################################################################
## FEND
##
## Cycles: 5
## ZSCO: ----
##
## Restores SP from FP and removes FP from the stack
################################################################################

instruction FEND {
  UL;
  LK(STACK); ADR(FP); LD(FP); LAD(SP); UL;
}

################################################################################
## RET
## RET <size>
##
## Cycles: 5-6
## ZSCO: ----
##
## Variants:
##   RET
##   RET.A <size>
##
## Pops 0-31 words from the stack, then pops IP from the stack.
################################################################################

instruction RET {
  UL;
  LK(STACK); ADR(SP); LD(IP); LAD(SP); UL;
}

instruction RET.A "$#5" {
  UL;
  ADD(SP,C0);
  LK(STACK); ADR(SP); LD(IP); LAD(SP); UL;
}

################################################################################
## RETC <condition>
## RETC <condition> <size>
##
## Cycles: 3-7
## ZSCO: ----
##
## Variants:
##   RETC   <condition>
##   RETC.A <condition> <size>
##
## If the specified condition is true, optionally pops 0-31 words from the
## stack, then pops IP from the stack.
################################################################################

instruction RETC "$#3" {
  UL;
  JC(a,@return);
  END;
@return:
  LK(STACK); ADR(SP); LD(IP); LAD(SP); UL;
}

instruction RETC.A "$#3, $#5" {
  UL;
  JC(a,@return);
  END;
@return:
  ADD(SP,C1);
  LK(STACK); ADR(SP); LD(IP); LAD(SP); UL;
}

################################################################################
## IRT
## IRT <size>
##
## Cycles: 6-7
## ZSCO: ----
##
## Variants:
##   IRT
##   IRT.A <size>
##
## Pops 0-31 words from the stack, then pops ST and IP from the stack. If the
## interrupt occurred during a WAIT, the WAIT resumes.
################################################################################

instruction IRT {
  UL;
  IRT;
}

instruction IRT.A "$#5" {
  UL;
  ADD(SP,C0);
  IRT;
}

################################################################################
## IRTC <condition>
## IRTC <condition> <size>
##
## Cycles: 3-8
## ZSCO: ----
##
## Variants:
##   IRTC   <condition>
##   IRTC.A <condition> <size>
##
## If the specified condition is true, optionally pops 0-31 words from the
## stack, then pops ST and IP from the stack. If the interrupt occurred during
## a WAIT, the WAIT resumes.
################################################################################

instruction IRTC "$#3" {
  UL;
  JC(a,@return);
  END;
@return:
  IRT;
}

instruction IRTC.A "$#3, $#5" {
  UL;
  JC(a,@return);
  END;
@return:
  ADD(SP,C1);
  IRT;
}

################################################################################
## EI
##
## Cycles: 3
## ZSCO: ----
##
## Enables interrupts.
################################################################################

instruction EI {
  UL;
  MSS(I);
  MSR(_,I);
}

################################################################################
## DI
##
## Cycles: 3
## ZSCO: ----
##
## Disables interrupts.
################################################################################

instruction DI {
  UL;
  MSC(I);
  MSR(I,_);
}

################################################################################
## GETI <interrupt> <register>
##
## Cycles: 5
## ZSCO: ----
##
## Retrieves the address of the specified interrupt and assigns to a register.
## Only the low 5 bits of <interrupt> are used.
################################################################################

instruction GETI "$v, $r" {
  LD(C0);
  UL;
  ILD(C0,a);
}

################################################################################
## SETI <interrupt> <word-value>
##
## Cycles: 5+
## ZSCO: ----
##
## Sets the address of the specified interrupt to a word value. Only the low 5
## bits of <interrupt> are used.
################################################################################

instruction SETI "$v, $m" {
  LD(C0);
  $GetWord;
  IST(C0,r);
}

################################################################################
## INT <interrupt>
##
## Cycles: 3+
## ZSCO: ----
##
## Triggers the specified interrupt, which is handled after this instruction if
## interrupts are enabled. Only the low 5 bits of <interrupt> are used.
################################################################################

instruction INT "$m" {
  $GetWord;
  INT(r);
}

################################################################################
## IN <port> <dst>
##
## Cycles: 4+
## ZSCO: -X--
##
## Variants:
##    IN.RW <reg>    <reg>
##    IN.RW <reg>    <word-address>
##    IN.IW <0..255> <reg>
##    IN.IW <0..255> <word-address>
##    IN.RD <reg>    <dreg>
##    IN.RD <reg>    <dword-address>
##    IN.ID <0..255> <dreg>
##    IN.ID <0..255> <dword-address>
##
## Unconditionally reads from the specified port and writes to the specified
## register or memory address. "S" flag is set if a new word was read, otherwise
## it is cleared. Dword variants read port word 0 into the low word and word 1
## into the high word.
################################################################################

macro(bits:5) ReadPortWord(p) {
  code "$r" {
    UL;
    PLK(p); PLD(S,m); MSR(S,S); PUL;
  }
  code "($r)" {
    UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LKR(m); ADR(m); ST(C0); UL;
  }
  code "($r + $v)" {
    LD(C2); UL; ADD(C2,m);
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LKR(m); ADR(C2); ST(C0); UL;
  }
  code "(SP)" {
    UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(STACK); ADR(SP); ST(C0); UL;
  }
  code "(SP + $v)" {
    LD(C2); UL; ADD(C2,SP);
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); UL;
  }
  code "(FP)" {
    UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(STACK); ADR(FP); ST(C0); UL;
  }
  code "(FP + $v)" {
    LD(C2); UL; ADD(C2,FP);
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); UL;
  }
  code "S($v)" {
    LD(C2); UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); UL;
  }
  code "D($v)" {
    LD(C2); UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(DATA); ADR(C2); ST(C0); UL;
  }
  code "E($v)" {
    LD(C2); UL;
    PLK(p); PLD(S,C0); MSR(S,S); PUL;
    LK(EXTRA); ADR(C2); ST(C0); UL;
  }
}

instruction IN.RW "$r, $m" {
  $ReadPortWord(a);
}

instruction IN.IW "$v, $m" {
  LD(MB);
  $ReadPortWord(MB);
}

macro(bits:5) ReadPortDword(p) {
  code "$R" {
    UL;
    PLK(p); PLD(A,m0); PLD(S,m1); MSR(S,S); PUL;
  }
  code "[$r]" {
    UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LKR(m); ADR(m); ST(C0); ST(C1); UL;
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m);
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LKR(m); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "[SP]" {
    UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(STACK); ADR(SP); ST(C0); ST(C1); UL;
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP);
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "[FP]" {
    UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(STACK); ADR(FP); ST(C0); ST(C1); UL;
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP);
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "S[$v]" {
    LD(C2); UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "D[$v]" {
    LD(C2); UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(DATA); ADR(C2); ST(C0); ST(C1); UL;
  }
  code "E[$v]" {
    LD(C2); UL;
    PLK(p); PLD(A,C0); PLD(S,C1); MSR(S,S); PUL;
    LK(EXTRA); ADR(C2); ST(C0); ST(C1); UL;
  }
}

instruction IN.RD "$r, $m" {
  $ReadPortDword(a);
}

instruction IN.ID "$v, $m" {
  LD(MB);
  $ReadPortDword(MB);
}

################################################################################
## INS <port> <dst>
##
## Cycles: 4+
## ZSCO: -X--
##
## Variants:
##    INS.RW <reg>    <reg>
##    INS.RW <reg>    <word-address>
##    INS.IW <0..255> <reg>
##    INS.IW <0..255> <word-address>
##    INS.RD <reg>    <dreg>
##    INS.RD <reg>    <dword-address>
##    INS.ID <0..255> <dreg>
##    INS.ID <0..255> <dword-address>
##
## Reads from the specified port if the port status is set and writes to the
## specified register or memory address. "S" flag is set if a word was read,
## otherwise it is cleared. Dword variants read port word 0 into the low word
## and word 1 into the high word.
##
## For a memory address, checking the port status costs nothing when a word is
## read, and a cycle when it isn't, favoring moving data over polling.
################################################################################

macro(bits:5) ReadPortWordIfReady(p) {
  code "$r" {
    UL;
    PLK(p); PLD(TS,m); MSR(S,S); PUL;
  }
  code "($r)" {
    UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LKR(m); ADR(m); ST(C0); UL;
  @done:
    END;
  }
  code "($r + $v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,m);
    LKR(m); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
  code "(SP)" {
    UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(SP); ST(C0); UL;
  @done:
    END;
  }
  code "(SP + $v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,SP);
    LK(STACK); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
  code "(FP)" {
    UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(FP); ST(C0); UL;
  @done:
    END;
  }
  code "(FP + $v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,FP);
    LK(STACK); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
  code "S($v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
  code "D($v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LK(DATA); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
  code "E($v)" {
    LD(C2); UL;
    PLK(p); PLD(TS,C0); MSR(S,S); PUL;
    JC(NS,@done);
    LK(EXTRA); ADR(C2); ST(C0); UL;
  @done:
    END;
  }
}

instruction INS.RW "$r, $m" {
  $ReadPortWordIfReady(a);
}

instruction INS.IW "$v, $m" {
  LD(MB);
  $ReadPortWordIfReady(MB);
}

macro(bits:5) ReadPortDwordIfReady(p) {
  code "$R" {
    UL;
    PLK(p); PLD(TA,m0); PLD(TS,m1); MSR(S,S); PUL;
  }
  code "[$r]" {
    UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LKR(m); ADR(m); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "[$r + $v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,m);
    LKR(m); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "[SP]" {
    UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(SP); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "[SP + $v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,SP);
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "[FP]" {
    UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(FP); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "[FP + $v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    ADD(C2,FP);
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "S[$v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LK(STACK); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "D[$v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LK(DATA); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
  code "E[$v]" {
    LD(C2); UL;
    PLK(p); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
    JC(NS,@done);
    LK(EXTRA); ADR(C2); ST(C0); ST(C1); UL;
  @done:
    END;
  }
}

instruction INS.RD "$r, $m" {
  $ReadPortDwordIfReady(a);
}

instruction INS.ID "$v, $m" {
  LD(MB);
  $ReadPortDwordIfReady(MB);
}

################################################################################
## INR <port>, <address>
##
## Cycles: 6-11 per execution
## ZSCO: -X--
##
## Variants:
##    INR.RW <reg>,    (<reg>)         (8 cycles per word)
##    INR.IW <0..255>, (<reg>)         (9 cycles per word)
##    INR.RD <reg>,    [<reg>]         (10 cycles per dword)
##    INR.ID <0..255>, [<reg>]         (11 cycles per dword)
##
## Reads up to R7 words (or dwords) from the port, storing them at the address
## in the address register (in the memory bank that register implies), and
## stepping the address register past each one. A word is read only if the port
## status is set, and R7 is decremented for each word read, so it is left at the
## number of words *not* read.
##
## Each execution reads one word, and then executes the instruction again if
## it isn't done, so interrupts are handled between words. It is done when R7
## is 0, which sets the "S" flag, or when the port status isn't set, which
## clears it.
##
## If R7 is 0, nothing is read, and it takes 6 cycles (7 for INR.IW and
## INR.ID). If the port status isn't set, it takes 7 cycles for INR.RW, 8 for
## INR.IW and INR.RD, and 9 for INR.ID.
################################################################################

instruction INR.RW "$r, ($r)" {
  UL;
  MSS(S); MSR(_,S);

  # R7 is decremented first, which clears C if it was 0, and sets Z if this is
  # the last word. Nothing after it changes Z or C, and R7 is restored if no
  # word is read.
  ADDI(R7,-1);
  JC(NC,@restore);
  PLK(a); PLD(TS,C0); MSR(S,S); PUL;
  JC(NS,@restore);
  LKR(b); ADR(b); ST(C0); LAD(b); UL;
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@restore:
  ADDI(R7,1);
}

instruction INR.IW "$v, ($r)" {
  LD(MB); UL;  # As INR.RW, with the port in MB and the address in a
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  PLK(MB); PLD(TS,C0); MSR(S,S); PUL;
  JC(NS,@restore);
  LKR(a); ADR(a); ST(C0); LAD(a); UL;
  JC(Z,@done);
  ADDI(IP,-2);
@done:
  END;
@restore:
  ADDI(R7,1);
}

instruction INR.RD "$r, [$r]" {
  UL;  # As INR.RW, a dword at a time
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  PLK(a); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
  JC(NS,@restore);
  LKR(b); ADR(b); ST(C0); ST(C1); LAD(b); UL;
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@restore:
  ADDI(R7,1);
}

instruction INR.ID "$v, [$r]" {
  LD(MB); UL;  # As INR.IW, a dword at a time
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  PLK(MB); PLD(TA,C0); PLD(TS,C1); MSR(S,S); PUL;
  JC(NS,@restore);
  LKR(a); ADR(a); ST(C0); ST(C1); LAD(a); UL;
  JC(Z,@done);
  ADDI(IP,-2);
@done:
  END;
@restore:
  ADDI(R7,1);
}

################################################################################
## OUT <port> <value>
##
## Cycles: 4+
## ZSCO: -1--
##
## Variants:
##    OUT.RW <reg>    <word-value>
##    OUT.IW <0..255> <word-value>
##    OUT.RD <reg>    <dword-value>
##    OUT.ID <0..255> <dword-value>
##
## Unconditionally writes the specified value to the specified port.
################################################################################

macro(bits:5) WritePortWord(p) {
  code "$r" {
    UL;
    PLK(p); PST(S,m); PUL;
    MSS(S); MSR(_,S);
  }
  code "($r)" {
    UL;
    LKR(m); ADR(m); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "($r + $v)" {
    LD(C2); UL; ADD(C2,m);
    LKR(m); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "(SP)" {
    UL;
    LK(STACK); ADR(SP); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "(SP + $v)" {
    LD(C2); UL; ADD(C2,SP);
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "(FP)" {
    UL;
    LK(STACK); ADR(FP); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "(FP + $v)" {
    LD(C2); UL; ADD(C2,FP);
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "$v" {
    LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "S($v)" {
    LD(C2); UL;
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "D($v)" {
    LD(C2); UL;
    LK(DATA); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
  code "E($v)" {
    LD(C2); UL;
    LK(EXTRA); ADR(C2); LD(C0); UL;
    PLK(p); PST(S,C0); PUL;
    MSS(S); MSR(_,S);
  }
}

instruction OUT.RW "$r, $m" {
  $WritePortWord(a);
}

instruction OUT.IW "$v, $m" {
  LD(MB);
  $WritePortWord(MB);
}

macro(bits:5) WritePortDword(p) {
  code "$R" {
    UL;
    PLK(p); PST(A,m0); PST(S,m1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[$r]" {
    UL;
    LKR(m); ADR(m); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m);
    LKR(m); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[SP]" {
    UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP);
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[FP]" {
    UL;
    LK(STACK); ADR(FP); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP);
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "$V" {
    LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "S[$v]" {
    LD(C2); UL;
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "D[$v]" {
    LD(C2); UL;
    LK(DATA); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
  code "E[$v]" {
    LD(C2); UL;
    LK(EXTRA); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(A,C0); PST(S,C1); PUL;
    MSS(S); MSR(_,S);
  }
}

instruction OUT.RD "$r, $m" {
  $WritePortDword(a);
}

instruction OUT.ID "$v, $m" {
  LD(MB);
  $WritePortDword(MB);
}

################################################################################
## OUTS <port> <value>
##
## Cycles: 4+
## ZSCO: -X--
##
## Variants:
##    OUTS.RW <reg>    <word-value>
##    OUTS.IW <0..255> <word-value>
##    OUTS.RD <reg>    <dword-value>
##    OUTS.ID <0..255> <dword-value>
##
## Writes the specified value to the specified port if the port status is not
## set. Sets the "S" flag if a value was written.
################################################################################

macro(bits:5) WritePortWordIfReady(p) {
  code "$r" {
    UL;
    PLK(p); PST(TS,m); PUL;
    MSX(S); MSR(S,S);
  }
  code "($r)" {
    UL;
    LKR(m); ADR(m); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "($r + $v)" {
    LD(C2); UL; ADD(C2,m);
    LKR(m); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "(SP)" {
    UL;
    LK(STACK); ADR(SP); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "(SP + $v)" {
    LD(C2); UL; ADD(C2,SP);
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "(FP)" {
    UL;
    LK(STACK); ADR(FP); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "(FP + $v)" {
    LD(C2); UL; ADD(C2,FP);
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "$v" {
    LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "S($v)" {
    LD(C2); UL;
    LK(STACK); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "D($v)" {
    LD(C2); UL;
    LK(DATA); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
  code "E($v)" {
    LD(C2); UL;
    LK(EXTRA); ADR(C2); LD(C0); UL;
    PLK(p); PST(TS,C0); PUL;
    MSX(S); MSR(S,S);
  }
}

instruction OUTS.RW "$r, $m" {
  $WritePortWordIfReady(a);
}

instruction OUTS.IW "$v, $m" {
  LD(MB);
  $WritePortWordIfReady(MB);
}

macro(bits:5) WritePortDwordIfReady(p) {
  code "$R" {
    UL;
    PLK(p); PST(TA,m0); PST(TS,m1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[$r]" {
    UL;
    LKR(m); ADR(m); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[$r + $v]" {
    LD(C2); UL; ADD(C2,m);
    LKR(m); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[SP]" {
    UL;
    LK(STACK); ADR(SP); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[SP + $v]" {
    LD(C2); UL; ADD(C2,SP);
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[FP]" {
    UL;
    LK(STACK); ADR(FP); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "[FP + $v]" {
    LD(C2); UL; ADD(C2,FP);
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "$V" {
    LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "S[$v]" {
    LD(C2); UL;
    LK(STACK); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "D[$v]" {
    LD(C2); UL;
    LK(DATA); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
  code "E[$v]" {
    LD(C2); UL;
    LK(EXTRA); ADR(C2); LD(C0); LD(C1); UL;
    PLK(p); PST(TA,C0); PST(TS,C1); PUL;
    MSX(S); MSR(S,S);
  }
}

instruction OUTS.RD "$r, $m" {
  $WritePortDwordIfReady(a);
}

instruction OUTS.ID "$v, $m" {
  LD(MB);
  $WritePortDwordIfReady(MB);
}

################################################################################
## OUTR <port>, <address>
##
## Cycles: 6-13 per execution
## ZSCO: -X--
##
## Variants:
##    OUTR.RW <reg>,    (<reg>)        (8 cycles per word)
##    OUTR.IW <0..255>, (<reg>)        (9 cycles per word)
##    OUTR.RD <reg>,    [<reg>]        (10 cycles per dword)
##    OUTR.ID <0..255>, [<reg>]        (11 cycles per dword)
##
## Writes up to R7 words (or dwords) to the port, loading them from the address
## in the address register (in the memory bank that register implies), and
## stepping the address register past each one. A word is written only if the
## port status is not set, and R7 is decremented for each word written, so it
## is left at the number of words *not* written.
##
## Each execution writes one word, and then executes the instruction again if
## it isn't done, so interrupts are handled between words. It is done when R7
## is 0, which sets the "S" flag, or when the port status is set, which clears
## it.
##
## If R7 is 0, nothing is written, and it takes 6 cycles (7 for OUTR.IW and
## OUTR.ID). The word is loaded before the port status is known, so when the
## port status is set, it takes two cycles more than a word.
################################################################################

instruction OUTR.RW "$r, ($r)" {
  UL;
  MSS(S); MSR(_,S);
  ADDI(R7,-1);  # As INR.RW
  JC(NC,@restore);
  LKR(b); ADR(b); LD(C0); LAD(b); UL;
  PLK(a); PST(TS,C0); PUL;
  MSX(S); MSR(S,S);
  JC(NS,@not_written);
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@not_written:
  ADDI(b,-1);
@restore:
  ADDI(R7,1);
}

instruction OUTR.IW "$v, ($r)" {
  LD(MB); UL;  # As OUTR.RW, with the port in MB and the address in a
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  LKR(a); ADR(a); LD(C0); LAD(a); UL;
  PLK(MB); PST(TS,C0); PUL;
  MSX(S); MSR(S,S);
  JC(NS,@not_written);
  JC(Z,@done);
  ADDI(IP,-2);
@done:
  END;
@not_written:
  ADDI(a,-1);
@restore:
  ADDI(R7,1);
}

instruction OUTR.RD "$r, [$r]" {
  UL;  # As OUTR.RW, a dword at a time
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  LKR(b); ADR(b); LD(C0); LD(C1); LAD(b); UL;
  PLK(a); PST(TA,C0); PST(TS,C1); PUL;
  MSX(S); MSR(S,S);
  JC(NS,@not_written);
  JC(Z,@done);
  ADDI(IP,-1);
@done:
  END;
@not_written:
  ADDI(b,-2);
@restore:
  ADDI(R7,1);
}

instruction OUTR.ID "$v, [$r]" {
  LD(MB); UL;  # As OUTR.IW, a dword at a time
  MSS(S); MSR(_,S);
  ADDI(R7,-1);
  JC(NC,@restore);
  LKR(a); ADR(a); LD(C0); LD(C1); LAD(a); UL;
  PLK(MB); PST(TA,C0); PST(TS,C1); PUL;
  MSX(S); MSR(S,S);
  JC(NS,@not_written);
  JC(Z,@done);
  ADDI(IP,-2);
@done:
  END;
@not_written:
  ADDI(a,-2);
@restore:
  ADDI(R7,1);
}

################################################################################
## RST <core-index> <bank-mask>
##
## Cycles: 11-28
## ZSCO: ----
##
## The core to reset may be specified as an immediate value 0-7 or the special
## keyword SELF (to reset the running core), or specified by register R2 (0..7,
## or -1 to indicate self). If the core does not exist, nothing changes.
##
## The core's memory banks are specified in R3 in the same configuration as in
## the MB register, depending on the bank mask:
##   Bit 0: CODE
##     The core's BC register is set to this core's R4 register.
##     The core's IP register is set to zero.
##     The core's R0 and R1 registers are copied from this core.
##     The core starts running from its new IP, if it was halted or waiting.
##   Bit 1: STACK
##     The core's BS register is set to this core's R5 register.
##     The core's FP and SP registers are set to zero.
##   Bit 2: DATA
##     The core's BD register is set to this core's R6 register.
##   Bit 3: EXTRA
##     The core's BE register is set to this core's R7 register.
################################################################################

macro LockCore {
  code "$#3" { CLK(i); }
  code "R2" { CLK(R2); }
  code "SELF" { MOVI(C2,-1); CLK(C2); }
}

instruction RST "$m, $#4" {
  UL;
  $LockCore;

@code:
  # Test if code is set
  MSKI(C1,1);
  JC(Z, @stack);

  # Update code registers
  MVN(C0:0,R3:0);
  CBK(CODE,C0);
  CST(BC,R4);
  MOVI(C0,0);
  CST(IP,C0);
  CST(R0,R0);
  CST(R1,R1);
  CRUN;

@stack:
  # Test if stack is set
  MSKI(C1,2);
  JC(Z, @data);

  # Update stack registers
  MVN(C0:0,R3:1);
  CBK(STACK,C0);
  CST(BS,R5);
  MOVI(C0,0);
  CST(SP,C0);
  CST(FP,C0);

@data:
  # Test if data is set
  MSKI(C1,4);
  JC(Z, @extra);

  # Update data registers
  MVN(C0:0,R3:2);
  CBK(DATA,C0);
  CST(BD,R6);

@extra:
  # Test if extra is set
  MSKI(C1,8);
  JC(Z, @end);

  # Update extra registers
  MVN(C0:0,R3:3);
  CBK(EXTRA,C0);
  CST(BE,R7);

@end:
  CUL;
}
