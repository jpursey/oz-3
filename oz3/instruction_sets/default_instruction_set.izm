    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0);
    SR(p1); MSR(Z,Z); RRC(p0);
    MSC(S); MSR(ZSCO,SCO);
  }
  code "15" {
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); RRC(p0); SR(p1); RRC(p0);
    SR(p1); MSR(Z,Z); RRC(p0);
    MSC(S); MSR(ZSCO,SCO);
  }
  code "16" {
    SL(p0); MSR(C,C); MOV(p0,p1); MOVI(p1,0);
    TST(p0); MSC(S); MSR(ZSO,ZSO);
  }
  code "17" {
    MOV(p0,p1); MOVI(p1,0);
    SR(p0);
    MSR(ZSCO,ZSCO);
