;===============================================================================
; The Ozzy default boot loader
;
; This is the default loader which is put on a newly formatted disk by default
; with the OZOS operating system. It also can be used to manually format a disk
; on a host machine with the oz3dsk tool.
;
; It loads OZOS.SYS, a bare program, from the boot drive into the RAM pages
; just after its own page, and starts it (see "Starting the OS" below for what
; the OS is given). If it can't, it shows an error, waits for a key, and
; restarts the Ozzy.
;
; The loader must fit in the 222 words before the boot signature, so it reads
; the whole file with one READ PACKED, sending each data block straight to
; where it goes as the words arrive.
;===============================================================================

;-------------------------------------------------------------------------------
; The stack
;
; The actual stack size specified here doesn't matter as the loader is not
; loaded like a program and is given an entire page of memory for its stack.
;-------------------------------------------------------------------------------

.STACK 0

;-------------------------------------------------------------------------------
; The machine table (see oz3/ozzy/machine_table.h), in EXTRA
;-------------------------------------------------------------------------------

.CONST TABLE = 0F00h
.CONST TABLE_DEVICES = TABLE + 6
.CONST TABLE_BANK_ENTRIES = TABLE + 8
.CONST TABLE_DEVICE_ENTRIES = TABLE + 28h

; A bank entry's RAM pages, and its size
.CONST BANK_RAM = 1
.CONST BANK_SIZE = 2

; A device entry's size, and its type
.CONST DEVICE_SIZE = 8
.CONST TELETYPE = 3

;-------------------------------------------------------------------------------
; Devices, which are wired the same in every Ozzy
;-------------------------------------------------------------------------------

.CONST POWER_PORT = 0
.CONST POWER_RESTART = 2
.CONST KEYBOARD_PORT = 1
.CONST TELETYPE_PORT = 2

; The screen's page, and its columns, in EXTRA. Without a screen the page is
; empty, so its columns read 0 and writes are ignored, or it is RAM.
.CONST SCREEN_START = 0F000h
.CONST SCREEN_COLUMNS = SCREEN_START + 0FF0h

; The boot ROM's status row, where the error replaces "Loading..."
.CONST STATUS_ROW = 7

; The error's size in words, two characters in each
.CONST ERROR_WORDS = 13

;-------------------------------------------------------------------------------
; The disk drive (see the manual's Disk Drive page)
;-------------------------------------------------------------------------------

; The drive's ports, from its command port
.CONST DRIVE_DATA = 1
.CONST DRIVE_CONTROL = 2

; Commands, with the handle in the low byte
.CONST DRIVE_CMD_OPEN        = 01000h
.CONST DRIVE_CMD_CLOSE       = 01300h
.CONST DRIVE_CMD_READ_PACKED = 02200h

; The control port's phase is idle (0) or arguments (1) until the drive has
; taken a command's last word
.CONST DRIVE_PHASE = 0Fh
.CONST DRIVE_PHASE_TAKEN = 0Eh

;-------------------------------------------------------------------------------
; Bare programs (see the manual's Program Files page)
;-------------------------------------------------------------------------------

; The identifier and version, as one dword
.CONST BARE_ID = 0001424Fh

.CONST PAGE_SIZE = 1000h

;-------------------------------------------------------------------------------
; Open the OS file
;
; Registers kept throughout:
;   R3 - The OS file's handle
;   R5 - The drive's command port
;   R6 - The drive's control port, then its data port
;-------------------------------------------------------------------------------

    PUSH R1                 ; The drive number, for the OS
    MOV R5, R0
    MOV R6, R0
    ADQ R6, DRIVE_CONTROL

    MOV R1, DRIVE_CMD_OPEN
    MOV R0, os_name
    MVQ R7, 4               ; The name is 8 words, sent as 4 dwords
    CALL command
    CALL read_status        ; The completion's
    CALL read_word          ; The handle
    MOV R3, R1

;-------------------------------------------------------------------------------
; Read the whole file, whose words are all on the data port from here on.
; command left R0 at read_count, just after the name.
;-------------------------------------------------------------------------------

    OR R1, DRIVE_CMD_READ_PACKED
    MVQ R7, 1
    CALL command
    CALL read_word          ; n, which is the whole file
    SBQ R6, DRIVE_CONTROL - DRIVE_DATA

    ; The header, into header
    MOV R0, header
    MVQ R7, 3
@header:
    INR.RD R6, [R0]
    JC NS, @header
    MOV D0, D[header]
    CMP D0, BARE_ID
    JC NZ, failed

;-------------------------------------------------------------------------------
; Allocate the pages after the loader's own, which the OS needs for its
; contents and stack, failing if they aren't all RAM. Pages past the end of
; the bank shift in as 0, so they aren't RAM either.
;-------------------------------------------------------------------------------

    ; R1 has a bit for each page needed, from bit 0
    MOV R0, D(header + 2)   ; Contents
    ADD R0, D(header + 3)   ; Stack (a full bank wraps to 0)
    PUSH R0                 ; The OS's size, for BS
    SBQ R0, 1
    SHR R0, 12              ; Pages needed - 1
    MVQ R1, 2
    SHL R1, R0              ; 16 pages shifts out to 0...
    SBQ R1, 1               ; ...which is FFFFh here

    ; R2 is the OS's first page, after the loader's
    MOV R2, BD
    SHR R2, 12
    ADQ R2, 1

    ; R4 is the RAM pages of the loader's bank (the STACK bank), from R2
    MOV R4, MB
    SHR R4, 4 - 1           ; The STACK bank, times BANK_SIZE
    AND R4, 0Fh * BANK_SIZE
    MOV R4, (R4 + TABLE_BANK_ENTRIES + BANK_RAM)
    SHR R4, R2

    AND R4, R1
    CMP R4, R1
    JC NZ, failed
    SHL R1, R2
    PUSH R1                 ; The OS's pages, for the OS

;-------------------------------------------------------------------------------
; Load each data block, at the OS's first page (PAGE_SIZE in DATA) plus its
; offset. A block is its offset and size in dwords, then its words.
;-------------------------------------------------------------------------------

    MOV R2, D(header + 4)   ; Blocks
@next:
    SBQ R2, 1
    JC C, @loaded
@offset:
    INS.RD R6, D0           ; R0 is the offset, R1 the size
    JC NS, @offset
    SHL R0, 1
    ADD R0, PAGE_SIZE
    MOV R7, R1
@block:
    INR.RD R6, [R0]
    JC NS, @block
    JPR @next
@loaded:
    ADQ R6, DRIVE_CONTROL - DRIVE_DATA
    CALL read_status        ; The completion's
    CALL read_word          ; The dwords read

;-------------------------------------------------------------------------------
; Close the file. It has no arguments, and R7 is already 0, as INR leaves it.
;-------------------------------------------------------------------------------

    MOV R1, R3
    OR R1, DRIVE_CMD_CLOSE
    CALL command
    CALL read_status        ; The completion's

;-------------------------------------------------------------------------------
; Starting the OS
;
; The OS is started as a bare program at the OS's first page, b: BC and BD
; are b, and BS is b plus its contents and stack, all in the loader's bank,
; with IP and SP 0. BE is left as bank 0 at base 0, for the machine table.
;
;   R0 - The boot drive's command port, as the loader was given it
;   R1 - The boot drive's number, as the loader was given it
;   R2 - The pages of its bank the OS is in, a bit for each
;
; The rest of RAM is free, including the loader's own page.
;-------------------------------------------------------------------------------

    MOV R0, R5
    POP R2
    POP R5
    POP R1
    MOV R4, BD
    ADD R4, PAGE_SIZE
    MOV R6, R4
    ADD R5, R4
    MOV R3, MB
    RST SELF, CODE | STACK | DATA

;-------------------------------------------------------------------------------
; read_word: Reads the next word from the drive's command port into R1, and
; sets Z if it is 0, as an OK status is.
;-------------------------------------------------------------------------------

read_word:
    INS R5, R1
    JC NS, read_word
    TST R1
    RET

;-------------------------------------------------------------------------------
; command: Sends the command word R1, then R7 dwords of arguments from R0, and
; reads the accept status, as read_status does. R0 is left past the arguments.
;-------------------------------------------------------------------------------

command:
@idle:
    IN R6, R4
    AND R4, DRIVE_PHASE
    JC NZ, @idle
@command:
    OUTS R5, R1
    JC NS, @command
@argument:
    OUTR.RD R5, [R0]
    JC NS, @argument
@taken:
    IN R6, R4
    AND R4, DRIVE_PHASE_TAKEN
    JC Z, @taken
    ; Fall through to read_status

;-------------------------------------------------------------------------------
; read_status: Reads the next word, a status, into R1, as read_word does, and
; returns if it is OK, or else fails. (Failing leaves the return address on
; the stack, which doesn't matter as the Ozzy restarts.)
;-------------------------------------------------------------------------------

read_status:
    CALL read_word
    RETC Z
    ; Fall through to failed

;-------------------------------------------------------------------------------
; failed: Shows the error on the teletype and the screen, waits for a key, and
; restarts the Ozzy.
;-------------------------------------------------------------------------------

failed:
    ; Write it to the teletype, if the machine table has one: the table says
    ; whether there is one, and the teletype is always on TELETYPE_PORT
    MOV R4, TABLE_DEVICE_ENTRIES
    MOV R7, E(TABLE_DEVICES)  ; At least 1, as the power control is there
@device:
    MOV R0, (R4)
    CMP R0, TELETYPE
    JC Z, @teletype
    ADQ R4, DEVICE_SIZE
    JD R7, @device
    JPR @screen
@teletype:
    MOV R0, error
    MVQ R7, ERROR_WORDS + 1   ; With the new line
@print:
    OUTR.IW TELETYPE_PORT, (R0)
    JC NS, @print

    ; Write it to the screen's status row, which is in the screen's page
    ; whatever is there
@screen:
    MOV R4, E(SCREEN_COLUMNS)
    MUL R4, STATUS_ROW
    AND R4, PAGE_SIZE - 1
    ADD R4, SCREEN_START
    MOV R0, error
    MVQ R7, ERROR_WORDS
@cell:
    MOV R1, (R0)
    MOV R2, R1
    AND R2, 0FFh
    MOV (R4), R2
    ADQ R4, 1
    SHR R1, 8
    MOV (R4), R1
    ADQ R4, 1
    ADQ R0, 1
    JD R7, @cell

@key:
    INS KEYBOARD_PORT, R0
    JC NS, @key
    OUT.IW POWER_PORT, POWER_RESTART
    HALT

;-------------------------------------------------------------------------------
; Constant data
;-------------------------------------------------------------------------------

; OPEN's name, then READ PACKED's count, the most there can be
os_name:
    .DW SIZE(6) "OZOS", SIZE(2) "SYS"
read_count:
    .DW 0FFFFh, 0

; An even number of characters, so every word has two for the screen
error:
    .DW SIZE(ERROR_WORDS) "ERROR: Can't load OZOS.SYS"
    .DW 0A0Dh               ; The teletype's new line

;-------------------------------------------------------------------------------
; Program End, including size validation and the boot signature
;-------------------------------------------------------------------------------

.CONST LOADER_END = $
.CONST LOADER_MAX_SIZE = 222
.IF LOADER_END > LOADER_MAX_SIZE
    .ERROR "Loader is ", LOADER_END, " words, exceeding ", LOADER_MAX_SIZE, " max words."
.ENDIF

.DS LOADER_MAX_SIZE - $
.DW "BOOT"

;-------------------------------------------------------------------------------
; Variables, after the boot signature in the loader's page
;-------------------------------------------------------------------------------

; The OS file's header: identifier, version, contents, stack, blocks, reserved
.CONST header = $
