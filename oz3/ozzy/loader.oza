;===============================================================================
; The Ozzy default boot loader
;
; This is the default loader which is put on a newly formatted disk by default
; with the OZOS operating system. It also can be used to manually format a disk
; on a host machine with the oz3dsk tool.
;
; It loads OZOS.SYS, a bare program, from the boot drive into RAM just after
; the loader and its stack, through as many of the pages after it as it needs,
; and starts it (see "Starting the OS" below for what the OS is given). If it
; can't, it hands back to the boot ROM with an error code, and the boot ROM
; shows it.
;
; The loader must fit in the 222 words before the boot signature, so it reads
; the whole file with one READ PACKED, sending each data block straight to
; where it goes as the words arrive.
;===============================================================================

;-------------------------------------------------------------------------------
; Where everything is
;
; The boot ROM starts the loader at LOADER_START in bank 0, with every bank
; bank 0, BC and BD at LOADER_START, and its stack ending at OS_START, so
; addresses here are from LOADER_START. The stack size specified here doesn't
; matter, as the loader is not loaded like a program.
;-------------------------------------------------------------------------------

.STACK 0

.CONST LOADER_START = 1000h
.CONST OS_START = 200h      ; 1200h, where the boot ROM's stack ends

; Where the boot ROM's exit is, at 0002h of bank 0
.CONST BOOT_ROM_EXIT = 0002h - LOADER_START

; Bank 0's RAM pages, in the machine table (see oz3/ozzy/machine_table.h)
.CONST TABLE = 0F00h - LOADER_START
.CONST TABLE_BANK0_RAM = TABLE + 9

;-------------------------------------------------------------------------------
; Error codes, which the boot ROM shows. A drive error is the drive's status
; (01h to 7Fh), and the loader's own are from ERROR_BASE.
;-------------------------------------------------------------------------------

.CONST ERROR_BASE = 0F0h
.CONST ERROR_NOT_BARE = 1   ; OZOS.SYS isn't a bare program
.CONST ERROR_SIZE = 2       ; It isn't as long as its header and blocks say
.CONST ERROR_FIT = 3        ; It doesn't fit in RAM

;-------------------------------------------------------------------------------
; The disk drive (see the manual's Disk Drive page)
;-------------------------------------------------------------------------------

; The drive's ports, from its command port
.CONST DRIVE_DATA = 1
.CONST DRIVE_CONTROL = 2

; Commands, with the handle in the low byte
.CONST DRIVE_CMD_OPEN        = 01000h
.CONST DRIVE_CMD_CLOSE       = 01300h
.CONST DRIVE_CMD_READ_PACKED = 02200h

; The control port's phase is idle (0) or arguments (1) until the drive has
; taken a command's last word
.CONST DRIVE_PHASE = 0Fh
.CONST DRIVE_PHASE_TAKEN = 0Eh

;-------------------------------------------------------------------------------
; Bare programs (see the manual's Program Files page)
;-------------------------------------------------------------------------------

; The identifier and version, as one dword
.CONST BARE_ID = 0001424Fh

;-------------------------------------------------------------------------------
; Open the OS file
;
; Registers kept throughout:
;   R3 - The dwords of the OS file still to read
;   R5 - The drive's command port
;   R6 - The drive's control port, then its data port
;-------------------------------------------------------------------------------

    PUSH R1                 ; The drive number, for the OS
    MOV R5, R0
    MOV R6, R0
    ADQ R6, DRIVE_CONTROL

    MOV R1, DRIVE_CMD_OPEN
    MOV R0, os_name
    MVQ R7, 4               ; The name is 8 words, sent as 4 dwords
    CALL command
    CALL read_status        ; The completion's
    CALL read_word          ; The handle
    MOV D(handle), R1

;-------------------------------------------------------------------------------
; Read the whole file, whose words are all on the data port from here on.
; command left R0 at read_count, just after the name. The file must be exactly
; what its header says, as reading past its end, or stopping short of it, would
; wait for the drive forever.
;-------------------------------------------------------------------------------

    OR R1, DRIVE_CMD_READ_PACKED
    MVQ R7, 1
    CALL command
    CALL read_word          ; n, which is the whole file
    MOV R3, R1
    SBQ R6, DRIVE_CONTROL - DRIVE_DATA

    ; The header, into header
    SBQ R3, 3
    JC C, wrong_size
    MOV R0, header
    MVQ R7, 3
@header:
    INR R6, [R0]
    JC NS, @header
    MOV D0, D[header]
    CMP D0, BARE_ID
    JC NZ, not_bare

;-------------------------------------------------------------------------------
; Allocate the pages from the loader's own (page 1) to the one the OS ends in,
; which it needs for its contents and stack from OS_START, failing if they
; aren't all RAM, or the OS would pass the end of the bank.
;-------------------------------------------------------------------------------

    MOV R0, D(header + 2)   ; Contents
    ADD R0, D(header + 3)   ; Stack
    JC C, too_big
    PUSH R0                 ; The OS's size, for BS
    ADD R0, LOADER_START + OS_START - 1
    JC C, too_big
    SHR R0, 12              ; The OS's last page, from 1 to 15

    ; R1 has a bit for each page from 1 to the last
    MVQ R1, 2
    SHL R1, R0              ; Page 15 shifts out to 0...
    SBQ R1, 2               ; ...which is FFFEh here
    MOV R4, D(TABLE_BANK0_RAM)
    AND R4, R1
    CMP R4, R1
    JC NZ, too_big
    PUSH R1                 ; The OS's pages, for the OS

;-------------------------------------------------------------------------------
; Load each data block, at OS_START plus its offset. A block is its offset and
; size in dwords, then its words.
;-------------------------------------------------------------------------------

    MOV R2, D(header + 4)   ; Blocks
@next:
    SBQ R2, 1
    JC C, @loaded
    SBQ R3, 1
    JC C, wrong_size
@offset:
    INS R6, D0              ; R0 is the offset, R1 the size
    JC NS, @offset
    SUB R3, R1
    JC C, wrong_size
    SHL R0, 1
    ADD R0, OS_START
    MOV R7, R1
@block:
    INR R6, [R0]
    JC NS, @block
    JPR @next
@loaded:
    TST R3                  ; More than the header says
    JC NZ, wrong_size
    ADQ R6, DRIVE_CONTROL - DRIVE_DATA
    CALL read_status        ; The completion's
    CALL read_word          ; The dwords read

;-------------------------------------------------------------------------------
; Close the file. It has no arguments, and R7 is already 0, as INR leaves it.
;-------------------------------------------------------------------------------

    MOV R1, D(handle)
    OR R1, DRIVE_CMD_CLOSE
    CALL command
    CALL read_status        ; The completion's

;-------------------------------------------------------------------------------
; Starting the OS
;
; The OS is started as a bare program at b, LOADER_START + OS_START (1200h):
; BC and BD are b, and BS is b plus its contents and stack, all in bank 0, with
; IP and SP 0. BE is left as bank 0 at base 0, for the machine table.
;
;   R0 - The boot drive's command port, as the loader was given it
;   R1 - The boot drive's number, as the loader was given it
;   R2 - The pages of bank 0 the OS is in, a bit for each, from page 1
;
; The rest of RAM is free, and so are the words of page 1 before b.
;-------------------------------------------------------------------------------

    MOV R0, R5
    POP R2
    POP R5
    POP R1
    MOV R4, LOADER_START + OS_START
    MOV R6, R4
    ADD R5, R4
    MVQ R3, 0
    RST SELF, CODE | STACK | DATA

;-------------------------------------------------------------------------------
; read_word: Reads the next word from the drive's command port into R1, and
; sets Z if it is 0, as an OK status is.
;-------------------------------------------------------------------------------

read_word:
    INS R5, R1
    JC NS, read_word
    TST R1
    RET

;-------------------------------------------------------------------------------
; command: Sends the command word R1, then R7 dwords of arguments from R0, and
; reads the accept status, as read_status does. R0 is left past the arguments.
;-------------------------------------------------------------------------------

command:
@idle:
    IN R6, R4
    AND R4, DRIVE_PHASE
    JC NZ, @idle
@command:
    OUTS R5, R1
    JC NS, @command
@argument:
    OUTR R5, [R0]
    JC NS, @argument
@taken:
    IN R6, R4
    AND R4, DRIVE_PHASE_TAKEN
    JC Z, @taken
    ; Fall through to read_status

;-------------------------------------------------------------------------------
; read_status: Reads the next word, a status, into R1, as read_word does, and
; returns if it is OK, or else fails with the status as the error code.
;-------------------------------------------------------------------------------

read_status:
    CALL read_word
    RETC Z
    JPR failed

;-------------------------------------------------------------------------------
; Failing: each sets R1 to its error code, and failed hands it back to the boot
; ROM in R0, which shows it. The boot ROM starts over, with a new stack, so
; what is left on this one doesn't matter.
;-------------------------------------------------------------------------------

too_big:
    MVQ R1, ERROR_FIT
    JPR with_base
wrong_size:
    MVQ R1, ERROR_SIZE
    JPR with_base
not_bare:
    MVQ R1, ERROR_NOT_BARE
with_base:
    OR R1, ERROR_BASE
failed:
    MOV R0, R1
    JP BOOT_ROM_EXIT

;-------------------------------------------------------------------------------
; Constant data
;-------------------------------------------------------------------------------

; OPEN's name, then READ PACKED's count, the most there can be
os_name:
    .DW SIZE(6) "OZOS", SIZE(2) "SYS"
read_count:
    .DW 0FFFFh, 0

;-------------------------------------------------------------------------------
; Program End, including size validation and the boot signature
;-------------------------------------------------------------------------------

.CONST LOADER_END = $
.CONST LOADER_MAX_SIZE = 222
.IF LOADER_END > LOADER_MAX_SIZE
    .ERROR "Loader is ", LOADER_END, " words, exceeding ", LOADER_MAX_SIZE, " max words."
.ENDIF

.DS LOADER_MAX_SIZE - $
.DW "BOOT"

;-------------------------------------------------------------------------------
; Variables, after the boot signature, below the stack
;-------------------------------------------------------------------------------

; The OS file's header: identifier, version, contents, stack, blocks, reserved
.CONST header = $

; The OS file's handle
.CONST handle = header + 6
