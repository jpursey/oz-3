;===============================================================================
; The Ozzy's boot ROM
;
; Core 0 runs this at power on, from page 0 of bank 0. It reads the machine
; table, clears the screen, and shows the banner on the screen (or, without
; one, on the teletype). With a keyboard, it then prompts, and waits for Enter
; to boot from A:, reading the disk's boot area into its stack's page and
; starting the loader there. Without one, it halts.
;
; The code and its strings are one ROM segment, which is also the DATA segment,
; so the machine table is read with D(n). The screen's page is the EXTRA bank.
; The stack is in a page of RAM the host places, and the variables are the
; first words pushed onto it, from S(-1) down. The loader goes at the start of
; the same page.
;===============================================================================

;-------------------------------------------------------------------------------
; The machine table (see oz3/ozzy/machine_table.h)
;-------------------------------------------------------------------------------

.CONST TABLE = 0F00h
.CONST TABLE_CLOCK_HZ = TABLE + 1
.CONST TABLE_CORES = TABLE + 3
.CONST TABLE_BANKS = TABLE + 5
.CONST TABLE_DEVICES = TABLE + 6
.CONST TABLE_BANK_ENTRIES = TABLE + 08h
.CONST TABLE_DEVICE_ENTRIES = TABLE + 28h

; A bank entry: its RAM pages are its second word.
.CONST BANK_RAM = 1
.CONST BANK_SIZE = 2

; A device entry.
.CONST DEVICE_TYPE = 0
.CONST DEVICE_PORT = 1
.CONST DEVICE_BANK = 4
.CONST DEVICE_PAGE = 5
.CONST DEVICE_COLUMNS = 6  ; A screen's
.CONST DEVICE_ROWS = 7
.CONST DEVICE_LETTER = 6   ; A drive's
.CONST DEVICE_SIZE = 8

; Device types.
.CONST SCREEN = 1
.CONST KEYBOARD = 2
.CONST TELETYPE = 3
.CONST DRIVE = 5

;-------------------------------------------------------------------------------
; The keyboard's wiring, which is the same in every Ozzy (see the manual's Ozzy
; Computer page), and the key that boots
;-------------------------------------------------------------------------------

.CONST KEYBOARD_PORT = 1
.CONST KEYBOARD_INTERRUPT = 1
.CONST KEY_ENTER = 0Dh

;-------------------------------------------------------------------------------
; The screen's control words and cell attributes (see the manual's Screen page)
;-------------------------------------------------------------------------------

.CONST SCREEN_CURSOR_COLUMN = 0FF5h
.CONST SCREEN_CURSOR_ROW = 0FF6h
.CONST SCREEN_CURSOR = 0FF7h
.CONST SCREEN_FILL = 0FF8h
.CONST SCREEN_FILL_ROW = 0FFAh

; A slow blinking underline, or no cursor.
.CONST CURSOR_STYLE = 2 | 8
.CONST CURSOR_OFF = 0

; The lines on a cell's edges, which draw the box.
.CONST LINE_TOP = 1000h
.CONST LINE_BOTTOM = 2000h
.CONST LINE_LEFT = 4000h
.CONST LINE_RIGHT = 8000h

;-------------------------------------------------------------------------------
; Where everything is on the screen
;-------------------------------------------------------------------------------

.CONST BANNER_ROWS = 4  ; The box is these rows
.CONST STATUS_ROW = 7   ; Below the box, a blank row, the prompt, a blank row

;-------------------------------------------------------------------------------
; The disk drive (see the manual's Disk Drive page)
;-------------------------------------------------------------------------------

; The drive's ports, from its command port.
.CONST DRIVE_DATA = 1
.CONST DRIVE_CONTROL = 2

; The control port: the reset request, and the state word's phase.
.CONST DRIVE_RESET = 1
.CONST DRIVE_PHASE = 0Fh
.CONST PHASE_WORKING = 2

; READ BOOT's command word, and the statuses the boot ROM names.
.CONST READ_BOOT = 4400h
.CONST NO_DISK = 20h
.CONST UNFORMATTED = 23h

; The drive it boots from, by letter and number.
.CONST BOOT_LETTER = 'A'
.CONST BOOT_DRIVE = 0

;-------------------------------------------------------------------------------
; The loader
;-------------------------------------------------------------------------------

; The boot area's size, in the dwords READ BOOT moves.
.CONST BOOT_AREA_DWORDS = 112

; The loader is the first words of the stack's page, which ends at BS.
.CONST PAGE_SIZE = 1000h
.CONST LOADER = -PAGE_SIZE

; The boot signature, "BOOT" packed, in the boot area's last two words.
.CONST SIGNATURE = LOADER + 2 * BOOT_AREA_DWORDS - 2
.CONST SIGNATURE_LOW = 4F42h
.CONST SIGNATURE_HIGH = 544Fh

;-------------------------------------------------------------------------------
; Variables, at S(n), in the order start pushes them
;-------------------------------------------------------------------------------

.CONST V_COLUMNS = -1    ; The screen's columns, or 0 without a screen
.CONST V_ROWS = -2       ; The screen's rows
.CONST V_COLUMN = -3     ; Where the next character goes on the screen
.CONST V_ROW = -4
.CONST V_TELETYPE = -5   ; The teletype's port, or 0FFFFh without one
.CONST V_KEYBOARD = -6   ; 1 with a keyboard, or 0 without one
.CONST V_DRIVE = -7      ; The boot drive's command port, or 0FFFFh without it
.CONST V_BOX_RIGHT = -8  ; The box's last column

; The words of each unit's text, for the clock rate.
.CONST UNIT_SIZE = 5

;-------------------------------------------------------------------------------
; Segments
;-------------------------------------------------------------------------------

.BANK rom, 1
.BANK ram
.STACK 128

.SEGMENT rom CODE DATA ROM PAGE(0) BANK(rom)

start:
    PUSH.W 0        ; V_COLUMNS
    PUSH.W 0        ; V_ROWS
    PUSH.W 0        ; V_COLUMN
    PUSH.W 0        ; V_ROW
    PUSH.W 0FFFFh   ; V_TELETYPE
    PUSH.W 0        ; V_KEYBOARD
    PUSH.W 0FFFFh   ; V_DRIVE
    PUSH.W 0        ; V_BOX_RIGHT
    CALL find_devices
    CALL clear_screen
    CALL print_banner

    ; Without a keyboard, nothing could answer a prompt. Interrupts are
    ; disabled from power on, so the core stays halted.
    TST S(V_KEYBOARD)
    JC NZ, @prompt
    HALT

@prompt:
    CALL new_line
    MOV R1, prompt_text
    CALL print_string
    CALL place_cursor
@wait:
    MOV R0, CURSOR_STYLE
    CALL set_cursor
    CALL wait_for_enter
    MVQ R0, CURSOR_OFF
    CALL set_cursor
    CALL boot
    CALL discard_keys
    CALL prompt_again
    JP @wait

version_text:
    .DW 'Ozzy 1.0', 0
prompt_text:
    .DW 'Press Enter to Boot...', 0

;-------------------------------------------------------------------------------
; find_devices: Finds the screen, the keyboard, the teletype, and the boot
; drive in the machine table. With a screen, sets the EXTRA bank to its page,
; and V_COLUMNS and V_ROWS to its size. With a keyboard, sets V_KEYBOARD, and
; wake as its interrupt's handler. With a teletype, sets V_TELETYPE to its
; port, and with the boot drive, V_DRIVE to its command port.
;-------------------------------------------------------------------------------

find_devices:
    MOV R2, D(TABLE_DEVICES)
    TST R2
    RETC Z
    MOV R1, TABLE_DEVICE_ENTRIES
@next:
    MOV R0, (R1 + DEVICE_TYPE)
    CMP R0, SCREEN
    JC NZ, @not_screen
    MOV R3, (R1 + DEVICE_BANK)
    SHL R3, 12
    MOV R7, (R1 + DEVICE_PAGE)
    SHL R7, 12
    RST SELF, EXTRA
    MOV R0, (R1 + DEVICE_COLUMNS)
    MOV S(V_COLUMNS), R0
    MOV R0, (R1 + DEVICE_ROWS)
    MOV S(V_ROWS), R0
    JP @step
@not_screen:
    CMP R0, KEYBOARD
    JC NZ, @not_keyboard
    MOV S(V_KEYBOARD), 1
    SETI KEYBOARD_INTERRUPT, wake
    JP @step
@not_keyboard:
    CMP R0, TELETYPE
    JC NZ, @not_teletype
    MOV R0, (R1 + DEVICE_PORT)
    MOV S(V_TELETYPE), R0
    JP @step
@not_teletype:
    CMP R0, DRIVE
    JC NZ, @step
    MOV R0, (R1 + DEVICE_LETTER)
    CMP R0, BOOT_LETTER
    JC NZ, @step
    MOV R0, (R1 + DEVICE_PORT)
    MOV S(V_DRIVE), R0
@step:
    ADQ R1, DEVICE_SIZE
    JD R2, @next
    RET

;-------------------------------------------------------------------------------
; clear_screen: Fills every row of the screen with spaces, which leaves the
; fill cell a space, for show_status.
;-------------------------------------------------------------------------------

clear_screen:
    TST S(V_COLUMNS)
    RETC Z
    MOV E(SCREEN_FILL), ' '
    MOV R2, S(V_ROWS)
@row:
    SBQ R2, 1
    MOV E(SCREEN_FILL_ROW), R2
    JC NZ, @row
    RET

;-------------------------------------------------------------------------------
; print_banner: Prints the banner, a line at a time, each followed by a new
; line. On the screen, each line starts a column in, and the banner is in a
; box. The teletype ignores the column and the box.
;-------------------------------------------------------------------------------

print_banner:
    PUSH R1
    MOV S(V_COLUMN), 1
    MOV R1, version_text
    CALL print_string
    CALL next_banner_line
    CALL next_banner_line
    CALL print_hardware
    CALL next_banner_line
    CALL print_drives
    CALL next_banner_line
    CALL draw_box
    POP R1
    RET

;-------------------------------------------------------------------------------
; next_banner_line: Widens the box to the blank column after the line, if it
; isn't that wide yet. Then starts a new line, leaving a blank column for the
; box's left side.
;-------------------------------------------------------------------------------

next_banner_line:
    PUSH R0
    MOV R0, S(V_COLUMN)
    CMP R0, S(V_BOX_RIGHT)
    JC C, @new_line
    MOV S(V_BOX_RIGHT), R0
@new_line:
    CALL new_line
    MOV S(V_COLUMN), 1
    POP R0
    RET

;-------------------------------------------------------------------------------
; draw_box: Draws the box around the banner, on its rows, from the first
; column to V_BOX_RIGHT. Each cell gets only the lines on the box's outside
; edges, as two cells' lines on the edge between them would draw it twice as
; thick. Only the cells on the screen are drawn.
;-------------------------------------------------------------------------------

draw_box:
    TST S(V_COLUMNS)
    RETC Z
    PUSH R0
    PUSH R1
    PUSH R2
    PUSH R3
    PUSH R4
    PUSH R5
    PUSH R6

    ; The box's rows (R5) and columns (R6) that are on the screen.
    MOV R5, S(V_ROWS)
    CMP R5, BANNER_ROWS
    JC C, @rows
    MOV R5, BANNER_ROWS
@rows:
    MOV R6, S(V_BOX_RIGHT)
    ADQ R6, 1
    CMP R6, S(V_COLUMNS)
    JC C, @columns
    MOV R6, S(V_COLUMNS)
@columns:
    MVQ R2, 0
@row:
    MOV R4, R2
    MUL R4, S(V_COLUMNS)
    MVQ R3, 0
@column:
    ; The lines for the cell's place in the box.
    MVQ R0, 0
    TST R2
    JC NZ, @not_top
    OR R0, LINE_TOP
@not_top:
    CMP R2, BANNER_ROWS - 1
    JC NZ, @not_bottom
    OR R0, LINE_BOTTOM
@not_bottom:
    TST R3
    JC NZ, @not_left
    OR R0, LINE_LEFT
@not_left:
    CMP R3, S(V_BOX_RIGHT)
    JC NZ, @not_right
    OR R0, LINE_RIGHT
@not_right:
    MOV R1, (R4)
    OR R1, R0
    MOV (R4), R1
    ADQ R4, 1
    ADQ R3, 1
    CMP R3, R6
    JC C, @column
    ADQ R2, 1
    CMP R2, R5
    JC C, @row

    POP R6
    POP R5
    POP R4
    POP R3
    POP R2
    POP R1
    POP R0
    RET

;-------------------------------------------------------------------------------
; print_hardware: Prints the cores, RAM, and clock rate.
;-------------------------------------------------------------------------------

print_hardware:
    PUSH R0
    PUSH R1
    PUSH.D D1
    MOV R2, D(TABLE_CORES)
    MVQ R3, 0
    CALL print_number
    MOV R1, core_text
    CALL print_string
    CMP R2, 1
    JC Z, @one_core
    MOV R0, 's'
    CALL put_char
@one_core:
    MOV R1, gap_text
    CALL print_string
    CALL count_ram
    CALL print_number
    MOV R1, ram_text
    CALL print_string
    MOV R1, gap_text
    CALL print_string
    CALL print_clock
    POP.D D1
    POP R1
    POP R0
    RET

core_text:
    .DW ' core', 0
gap_text:
    .DW '  ', 0
ram_text:
    .DW 'K RAM', 0

; The clock rate's units, each UNIT_SIZE words, from the smallest.
unit_text:
    .DW SIZE(UNIT_SIZE) ' Hz'
    .DW SIZE(UNIT_SIZE) ' kHz'
    .DW SIZE(UNIT_SIZE) ' MHz'

;-------------------------------------------------------------------------------
; print_drives: Prints the drives' letters, in the order the machine table has
; them, or that there are none.
;-------------------------------------------------------------------------------

print_drives:
    PUSH R0
    PUSH R1
    PUSH R2
    PUSH R3
    MOV R1, drives_text
    CALL print_string
    MVQ R3, 0
    MOV R2, D(TABLE_DEVICES)
    TST R2
    JC Z, @none
    MOV R1, TABLE_DEVICE_ENTRIES
@next:
    MOV R0, (R1 + DEVICE_TYPE)
    CMP R0, DRIVE
    JC NZ, @step
    TST R3
    JC Z, @letter
    PUSH R1
    MOV R1, comma_text
    CALL print_string
    POP R1
@letter:
    MOV R0, (R1 + DEVICE_LETTER)
    CALL put_char
    ADQ R3, 1
@step:
    ADQ R1, DEVICE_SIZE
    JD R2, @next

@none:
    TST R3
    JC NZ, @done
    MOV R1, none_text
    CALL print_string
@done:
    POP R3
    POP R2
    POP R1
    POP R0
    RET

drives_text:
    .DW 'Drives: ', 0
comma_text:
    .DW ', ', 0
none_text:
    .DW 'none', 0

;-------------------------------------------------------------------------------
; place_cursor: Places the screen's cursor where the next character goes.
;-------------------------------------------------------------------------------

place_cursor:
    TST S(V_COLUMNS)
    RETC Z
    PUSH R0
    MOV R0, S(V_COLUMN)
    MOV E(SCREEN_CURSOR_COLUMN), R0
    MOV R0, S(V_ROW)
    MOV E(SCREEN_CURSOR_ROW), R0
    POP R0
    RET

;-------------------------------------------------------------------------------
; set_cursor: Sets the screen's cursor to the mode and style in R0.
;-------------------------------------------------------------------------------

set_cursor:
    TST S(V_COLUMNS)
    RETC Z
    MOV E(SCREEN_CURSOR), R0
    RET

;-------------------------------------------------------------------------------
; wait_for_enter: Waits for Enter, ignoring every other key, whatever modifier
; keys are held with it. Interrupts are enabled while it waits, so the
; keyboard's interrupt can end each WAIT (see wake), and disabled again once it
; returns.
;-------------------------------------------------------------------------------

wait_for_enter:
    PUSH R0
    EI
@poll:
    INS KEYBOARD_PORT, R0
    JC S, @key

    ; A key that comes before the WAIT starts makes it end at once.
    MOV R0, 0FFFFh
    WAIT R0
    JP @poll
@key:
    AND R0, 0FFh
    CMP R0, KEY_ENTER
    JC NZ, @poll
    DI
    POP R0
    RET

;-------------------------------------------------------------------------------
; wake: The keyboard's interrupt handler, which ends wait_for_enter's WAIT, so
; it reads the key.
;-------------------------------------------------------------------------------

wake:
    WAKE SELF
    IRT

;-------------------------------------------------------------------------------
; boot: Boots from the boot drive (see read_boot_area), showing each status as
; it goes. With a loader, starts it, and never returns. Otherwise, returns once
; it has shown why it can't.
;-------------------------------------------------------------------------------

boot:
    PUSH R0
    PUSH R1
    PUSH R2
    MOV R1, loading_text
    CALL show_status
    MOV R1, no_drive_text
    MOV R0, S(V_DRIVE)
    CMP R0, 0FFFFh
    JC Z, @failed
    CALL read_boot_area
    MOV R1, no_disk_text
    CMP R2, NO_DISK
    JC Z, @failed
    MOV R1, unformatted_text
    CMP R2, UNFORMATTED
    JC Z, @failed
    TST R2
    JC NZ, @disk_error
    MOV R1, not_system_text
    MOV R2, S(SIGNATURE)
    CMP R2, SIGNATURE_LOW
    JC NZ, @failed
    MOV R2, S(SIGNATURE + 1)
    CMP R2, SIGNATURE_HIGH
    JC NZ, @failed

    ; The new line ends the status's line on the teletype.
    MOV R1, ready_text
    CALL show_status
    CALL new_line
    JP start_loader

@disk_error:
    MOV R1, disk_error_text
    CALL show_status
    MOV R0, R2
    CALL print_hex_byte
    MOV R0, 'h'
    CALL put_char
    JP @done
@failed:
    CALL show_status
@done:
    POP R2
    POP R1
    POP R0
    RET

loading_text:
    .DW 'Loading...', 0
ready_text:
    .DW 'Ready', 0
no_drive_text:
    .DW 'ERROR: No drive A:', 0
no_disk_text:
    .DW 'ERROR: No disk in drive A:', 0
unformatted_text:
    .DW 'ERROR: Disk not formatted', 0
not_system_text:
    .DW 'ERROR: Not a system disk', 0
disk_error_text:
    .DW 'ERROR: Disk error ', 0

;-------------------------------------------------------------------------------
; read_boot_area: Reads the boot area of the disk in the drive whose command
; port is R0 into the loader's words, with READ BOOT, and sets R2 to its status:
; the accept's if that fails, or else the completion's. It resets the drive
; first, so it starts from idle whatever the last boot left, and polls the
; ports, so it never needs the drive's interrupt.
;-------------------------------------------------------------------------------

read_boot_area:
    PUSH R1
    PUSH R3
    PUSH R6
    PUSH R7
    MOV R1, R0
    ADQ R1, DRIVE_CONTROL
@reset:
    OUTS.RW R1, DRIVE_RESET
    JC NS, @reset
@resetting:
    TSTP R1
    JC S, @resetting
@command:
    OUTS.RW R0, READ_BOOT
    JC NS, @command

    ; The drive has taken the command word once the phase is past arguments.
@accepting:
    IN R1, R2
    AND R2, DRIVE_PHASE
    CMP R2, PHASE_WORKING
    JC C, @accepting
    CALL read_status
    TST R2
    JC NZ, @done

    MOV R3, R0
    ADQ R3, DRIVE_DATA
    MOV R6, LOADER
    MOV R7, BOOT_AREA_DWORDS
@data:
    INR R3, [R6]
    JC NS, @data
    CALL read_status

@done:
    POP R7
    POP R6
    POP R3
    POP R1
    RET

;-------------------------------------------------------------------------------
; read_status: Sets R2 to the next word from the drive whose command port is
; R0, waiting for it.
;-------------------------------------------------------------------------------

read_status:
    INS R0, R2
    JC NS, read_status
    RET

;-------------------------------------------------------------------------------
; start_loader: Starts the loader with RST, which never returns: CODE and DATA
; are the stack's page, from its start, STACK is the same bank, ending at the
; end of the page, and EXTRA is bank 0. R0 is the boot drive's command port,
; and R1 its drive number.
;
; First it throws away the keys typed while booting. RST keeps pending
; interrupts, so it then drops those the boot ROM's work left, such as the
; drive's for READ BOOT's completion, which the loader would otherwise take for
; its own command's, and the keyboard's for the keys it threw away. With no
; handlers set, they are dropped as soon as interrupts are enabled.
;-------------------------------------------------------------------------------

start_loader:
    SETI KEYBOARD_INTERRUPT, 0
    CALL discard_keys
    EI
    DI
    CALL find_stack_bank
    MOV R2, R3
    SHL R2, 4
    OR R3, R2
    SHL R2, 4
    OR R3, R2
    MOV R5, BS
    MOV R4, R5
    SUB R4, PAGE_SIZE
    MOV R6, R4
    MVQ R7, 0
    MOV R0, S(V_DRIVE)
    MVQ R1, BOOT_DRIVE
    RST SELF, CODE | STACK | DATA | EXTRA

;-------------------------------------------------------------------------------
; find_stack_bank: Sets R3 to the stack's bank, which is the lowest that has
; RAM, as the Ozzy places the stack there.
;-------------------------------------------------------------------------------

find_stack_bank:
    PUSH R1
    MVQ R3, 0
    MOV R1, TABLE_BANK_ENTRIES + BANK_RAM
@bank:
    TST (R1)
    JC NZ, @done
    ADQ R3, 1
    ADQ R1, BANK_SIZE
    JP @bank
@done:
    POP R1
    RET

;-------------------------------------------------------------------------------
; discard_keys: Throws away the keys typed while booting, so they neither count
; toward the next prompt nor reach the loader.
;-------------------------------------------------------------------------------

discard_keys:
    PUSH R0
@next:
    INS KEYBOARD_PORT, R0
    JC S, @next
    POP R0
    RET

;-------------------------------------------------------------------------------
; show_status: Shows the status at R1 in DATA. On the screen, it replaces the
; last on the status row, clearing the row. On the teletype, it starts a new
; line.
;-------------------------------------------------------------------------------

show_status:
    PUSH R0
    TST S(V_COLUMNS)
    JC NZ, @screen
    CALL new_line
    JP @print
@screen:
    MOV R0, STATUS_ROW
    MOV S(V_ROW), R0
    MOV S(V_COLUMN), 0
    CMP R0, S(V_ROWS)
    JC NC, @print
    MOV E(SCREEN_FILL_ROW), R0
@print:
    POP R0
    JP print_string

;-------------------------------------------------------------------------------
; prompt_again: On the teletype, prints a blank line and the prompt after a
; failed boot. The screen still shows its prompt.
;-------------------------------------------------------------------------------

prompt_again:
    TST S(V_COLUMNS)
    RETC NZ
    PUSH R1
    CALL new_line
    CALL new_line
    MOV R1, prompt_text
    CALL print_string
    POP R1
    RET

;-------------------------------------------------------------------------------
; put_char: Prints the character in R0. On the screen, it goes where the next
; character goes, which then moves right, and isn't drawn if that is past the
; right edge or the bottom row.
;-------------------------------------------------------------------------------

put_char:
    PUSH R1
    PUSH R4
    TST S(V_COLUMNS)
    JC Z, @teletype
    MOV R1, S(V_COLUMN)
    CMP R1, S(V_COLUMNS)
    JC NC, @moved
    MOV R4, S(V_ROW)
    CMP R4, S(V_ROWS)
    JC NC, @moved
    MUL R4, S(V_COLUMNS)
    ADD R4, R1
    MOV (R4), R0
@moved:
    ADQ R1, 1
    MOV S(V_COLUMN), R1
    JP @done

@teletype:
    MOV R1, S(V_TELETYPE)
    CMP R1, 0FFFFh
    JC Z, @done
@write:
    OUTS R1, R0
    JC NS, @write

@done:
    POP R4
    POP R1
    RET

;-------------------------------------------------------------------------------
; new_line: Starts a new line. On the screen, it moves to the start of the next
; row, and never scrolls. On the teletype, it is a carriage return and a line
; feed.
;-------------------------------------------------------------------------------

new_line:
    PUSH R0
    TST S(V_COLUMNS)
    JC Z, @teletype
    MOV S(V_COLUMN), 0
    MOV R0, S(V_ROW)
    ADQ R0, 1
    MOV S(V_ROW), R0
    JP @done

@teletype:
    MVQ R0, 0Dh
    CALL put_char
    MVQ R0, 0Ah
    CALL put_char

@done:
    POP R0
    RET

;-------------------------------------------------------------------------------
; print_string: Prints the string at R1 in DATA, one character a word, ending
; with a 0.
;-------------------------------------------------------------------------------

print_string:
    PUSH R0
    PUSH R1
@next:
    MOV R0, (R1)
    TST R0
    JC Z, @done
    CALL put_char
    ADQ R1, 1
    JP @next
@done:
    POP R1
    POP R0
    RET

;-------------------------------------------------------------------------------
; print_hex_byte: Prints the low byte of R0 as two hex digits.
;-------------------------------------------------------------------------------

print_hex_byte:
    PUSH R0
    PUSH R1
    MOV R1, R0
    SHR R0, 4
    AND R0, 0Fh
    CALL print_hex_digit
    MOV R0, R1
    AND R0, 0Fh
    CALL print_hex_digit
    POP R1
    POP R0
    RET

; Prints the hex digit for R0, from 0 to 15, changing R0.
print_hex_digit:
    CMP R0, 10
    JC C, @decimal
    ADD R0, 'A' - '0' - 10
@decimal:
    ADD R0, '0'
    JP put_char

;-------------------------------------------------------------------------------
; print_clock: Prints the clock rate in the largest of Hz, kHz, and MHz that
; it is a whole number of.
;-------------------------------------------------------------------------------

print_clock:
    PUSH R1
    PUSH.D D1
    PUSH.D D2
    PUSH R6
    MOV D1, D[TABLE_CLOCK_HZ]
    MOV R1, unit_text
    MVQ R6, 2
@unit:
    MOV D2, D1
    MOD D2, 1000
    TST R4
    JC NZ, @print
    DIV D1, 1000
    ADQ R1, UNIT_SIZE
    JD R6, @unit
@print:
    CALL print_number
    CALL print_string

    POP R6
    POP.D D2
    POP.D D1
    POP R1
    RET

;-------------------------------------------------------------------------------
; print_number: Prints the dword in D1 in decimal.
;-------------------------------------------------------------------------------

print_number:
    PUSH R0
    PUSH.D D1
    PUSH.D D2
    PUSH R7
    MVQ R7, 0

    ; The digits are pushed from the last, and popped from the first.
@divide:
    MOV D2, D1
    MOD D2, 10
    DIV D1, 10
    ADD R4, '0'
    PUSH R4
    ADQ R7, 1
    TST D1
    JC NZ, @divide
@print:
    POP R0
    CALL put_char
    JD R7, @print

    POP R7
    POP.D D2
    POP.D D1
    POP R0
    RET

;-------------------------------------------------------------------------------
; count_ram: Sets D1 to the K (1024 words) of RAM in every bank, 4 a page.
;-------------------------------------------------------------------------------

count_ram:
    PUSH R0
    PUSH R1
    PUSH R6
    PUSH R7
    MVQ D1, 0
    MOV R6, D(TABLE_BANKS)
    MOV R1, TABLE_BANK_ENTRIES + BANK_RAM
@bank:
    MOV R0, (R1)

    ; Each pass clears the lowest set bit, until none are left.
@page:
    TST R0
    JC Z, @next_bank
    MOV R7, R0
    SBQ R7, 1
    AND R0, R7
    ADQ R2, 4
    JP @page
@next_bank:
    ADQ R1, BANK_SIZE
    JD R6, @bank

    POP R7
    POP R6
    POP R1
    POP R0
    RET

;-------------------------------------------------------------------------------
; The stack, with the variables at its top
;-------------------------------------------------------------------------------

.SEGMENT stack STACK BANK(ram)
